{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"$CLAUDE_PROJECT_DIR/scripts/host_guard.py\" hook",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
