; case: positive-unrelated-unknown
; expect: ok
; why: An undescribed fact sits outside the dependency closure. §5.3: irrelevant unknowns do
;   not invalidate unrelated systems.
;
(eadl-version eadl/1)

(defblock timer.counter (offers counter-width))
(defblock other.engine (offers transfer-engine) (needs descriptor-format))
(defplatform soc.p (offers (core-count 1 tick)) (requires (uses timer.counter)))
(defservice time.monotonic (requires (needs counter-width)))
(defsystem s
  (task t (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses time.monotonic))
  (requires (uses time.monotonic))
  (platform (uses soc.p)))
