; case: positive-explicit-absence-unused
; expect: ok
; why: A platform declares a capability absent and nothing requires it. An absence that
;   nothing relies on is simply a fact.
;
(defblock timer.counter (offers counter-width) (absent low-power-timer))
(defplatform soc.p (offers (core-count 1 tick)) (requires (uses timer.counter)))
(defservice time.monotonic (requires (needs counter-width)))
(defsystem s
  (task t (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses time.monotonic))
  (requires (uses time.monotonic))
  (platform (uses soc.p)))
