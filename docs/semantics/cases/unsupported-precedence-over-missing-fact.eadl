; case: unsupported-precedence-over-missing-fact
; expect: unsupported-profile
; why: A description with BOTH an out-of-profile request and an undescribed fact. The profile
;   refusal wins: describing the fact would be wasted work on a system the profile refuses
;   anyway.
;
(eadl-version eadl/1)

(defblock timer.counter (offers counter-width))
(defplatform soc.p (offers (core-count 1 tick)) (requires (uses timer.counter)))
(defservice time.monotonic (requires (needs counter-width wrap-behavior)))
(defservice q (requires (needs general-ipc)))
(defsystem s
  (task t (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses time.monotonic q))
  (requires (uses time.monotonic q))
  (platform (uses soc.p)))
