== system pe
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system pe)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task pe t) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses soc))
(task 1 (task pe u) (rank 2) (period 1/50 s) (deadline 1/50 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses soc))
(bind soc absolute-deadline (adapter deadline-over-delay timer.d soc))
(bind (adapter deadline-over-delay timer.d soc) counter-modulus timer.d)
(bind (adapter deadline-over-delay timer.d soc) observation-coherent timer.d)
(bind (adapter deadline-over-delay timer.d soc) relative-delay timer.d)
(bind (adapter deadline-over-delay timer.d soc) tick-rate timer.d)
(instance (adapter deadline-over-delay timer.d soc) (obliged delivery-bound 1/200 s) (obligations delivery chain) (costs expiry))
(timer simulator (releases (task pe t) (task pe u)))
(route 1 (timer-route timer.d) (separation programmed) (level machine) (deliverable yes) (requesters soc) (costs ((adapter deadline-over-delay timer.d soc) expiry)))
(enabled timer (timer-route timer.d))
(interrupt-model (nesting no) (masking all))
(node (adapter deadline-over-delay timer.d soc) instance)
(node soc platform)
(node timer.d block)
(context (adapter deadline-over-delay timer.d soc) job (interrupt (timer-route timer.d)) initialisation)
(context (task pe t) job)
(context (task pe u) job)
(context soc job (interrupt (timer-route timer.d)) initialisation)
(context timer.d job (interrupt (timer-route timer.d)) initialisation)
(depends (adapter deadline-over-delay timer.d soc) soc (because (binding absolute-deadline)))
(depends timer.d (adapter deadline-over-delay timer.d soc) (because (binding counter-modulus) (binding observation-coherent) (binding relative-delay) (binding tick-rate)))
(step 1 timer.d)
(step 2 (adapter deadline-over-delay timer.d soc))
(step 3 soc)
(obligation chain (adapter deadline-over-delay timer.d soc) (discharged-by M4.2 M4.8))
(obligation delivery (adapter deadline-over-delay timer.d soc) (discharged-by M4.2 M4.8))
(obligation multiplex soc (discharged-by M4.2 M2.21.2))
(obligation route (timer-route timer.d) (discharged-by M4.2 M4.3))
