(eadl-version eadl/1)
; A source declaring its separation absent, handled by a service a periodic task calls: no task is released by
; it, so the plan owes nothing of its separation (§2.5, §2.10; round 21, D1; round 22, R2).
(defblock dev.a
  (offers (interrupt-source true) (reachable-at-privilege machine))
  (absent min-arrival-separation))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses dev.a)))
(defservice h (requires (needs interrupt-source)))
(defsystem ab
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses h))
  (platform (uses soc)))
