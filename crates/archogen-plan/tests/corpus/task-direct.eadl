(eadl-version eadl/1)
; A task bound directly to a block for a shared fact: the block's code runs in the job.
(defblock console.uart
  (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform host.p
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses console.uart)))
(defsystem td
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (needs observable-output))
  (platform (uses host.p)))
