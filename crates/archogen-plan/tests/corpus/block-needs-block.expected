== system bk
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system bk)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task bk p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses out))
(bind evt interrupt-source dev.e)
(bind out observable-output nic)
(timer simulator (releases (task bk p)))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task bk p) job)
(context dev.e (interrupt (source dev.e)) initialisation)
(context evt (interrupt (source dev.e)) initialisation)
(context nic job initialisation)
(context out job initialisation)
(depends dev.e evt (because (binding interrupt-source)))
(depends nic out (because (binding observable-output)))
(step 1 dev.e)
(step 2 evt)
(step 3 nic)
(step 4 out)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task bk p) entry-point (by application))
(owed (task bk p) execution-bound (by application))
(owed (task bk p) execution-category (by application))
(owed (task bk p) figures-under-preemption (by application))
(owed (task bk p) masked-category (by application))
(owed (task bk p) masked-runs (by application))
(owed (task bk p) masks-only-through-api (by application))
(owed (task bk p) os-calls (by application))
(owed (task bk p) stack-bound (by application))
(owed (task bk p) stack-category (by application))
(owed (task bk p) task-facts (by application))
(owed bk leaves-interrupt-hardware-alone (by application))
(owed dev.e contexts (by realization))
(owed dev.e no-wait (by realization))
(owed evt contexts (by realization))
(owed evt no-wait (by realization))
(owed nic call-cost (by realization))
(owed nic contexts (by realization))
(owed nic no-wait (by realization))
(owed out call-cost (by realization))
