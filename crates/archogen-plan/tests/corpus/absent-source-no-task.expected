(task 0 (task ab p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses h))
(bind h interrupt-source dev.a)
(timer simulator (releases (task ab p)))
(route 1 (source dev.a) (separation absent) (level machine) (deliverable yes) (requesters h) (costs))
(enabled timer (source dev.a))
(interrupt-model (nesting no) (masking all))
(node dev.a block)
(node h service)
(context (task ab p) job)
