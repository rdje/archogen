(eadl-version eadl/1)
; Two systems, `c`'s task naming the system `a`: lowering `a`, whose requesters name none, is not refused (§1; round
; 12, remark 1).
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform host.p (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses console.uart)))
(defservice console.write (requires (needs observable-output)))
(defsystem a
  (task t (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses console.write))
  (platform (uses host.p)))
(defsystem c
  (task u (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses a))
  (platform (uses host.p)))
