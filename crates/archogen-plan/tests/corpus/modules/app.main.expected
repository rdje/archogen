(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system app)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task app s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source hw.dev.e every)) (uses os.evt))
(task 1 (task app p) (rank 2) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses os.alarm))
(bind os.alarm relative-delay hw.timer.d)
(bind os.evt interrupt-source hw.dev.e)
(timer simulator (releases (task app p)))
(route 1 (source hw.dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters os.evt) (costs))
(route 2 (timer-route hw.timer.d) (separation programmed) (level machine) (deliverable yes) (requesters os.alarm) (costs))
(enabled timer (source hw.dev.e) (timer-route hw.timer.d))
(interrupt-model (nesting no) (masking all))
(node hw.dev.e block)
(node hw.timer.d block)
(node os.alarm service)
(node os.evt service)
(context (task app p) job)
(context (task app s) job)
(context hw.dev.e job (interrupt (source hw.dev.e)) initialisation)
(context hw.timer.d job (interrupt (timer-route hw.timer.d)) initialisation)
(context os.alarm job (interrupt (timer-route hw.timer.d)) initialisation)
(context os.evt job (interrupt (source hw.dev.e)) initialisation)
(depends hw.dev.e os.evt (because (binding interrupt-source)))
(depends hw.timer.d os.alarm (because (binding relative-delay)))
(step 1 hw.dev.e)
(step 2 hw.timer.d)
(step 3 os.alarm)
(step 4 os.evt)
(obligation route (source hw.dev.e) (discharged-by M4.2 M4.3))
(obligation route (timer-route hw.timer.d) (discharged-by M4.2 M4.3))
(owed (source hw.dev.e) acknowledge-point (by realization))
(owed (source hw.dev.e) deferred-work (by realization))
(owed (source hw.dev.e) no-application-code (by realization))
(owed (source hw.dev.e) one-request-per-arrival (by realization))
(owed (source hw.dev.e) service-cost (by realization))
(owed (task app p) entry-point (by application))
(owed (task app p) execution-bound (by application))
(owed (task app p) execution-category (by application))
(owed (task app p) figures-under-preemption (by application))
(owed (task app p) masked-category (by application))
(owed (task app p) masked-runs (by application))
(owed (task app p) masks-only-through-api (by application))
(owed (task app p) os-calls (by application))
(owed (task app p) os-calls-category (by application))
(owed (task app p) stack-bound (by application))
(owed (task app p) stack-category (by application))
(owed (task app p) task-facts (by application))
(owed (task app s) entry-point (by application))
(owed (task app s) execution-bound (by application))
(owed (task app s) execution-category (by application))
(owed (task app s) figures-under-preemption (by application))
(owed (task app s) masked-category (by application))
(owed (task app s) masked-runs (by application))
