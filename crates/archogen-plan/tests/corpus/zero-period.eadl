(eadl-version eadl/1)
; A period and a deadline of zero: no run can release the task, refused (§1; round 8, D4) until `M1.42` makes the
; check refuse it.
(defblock console.uart
  (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform host.p
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses console.uart)))
(defservice console.write
  (requires (needs observable-output)))
(defsystem z
  (task a (period 0 ms) (deadline 0 ms) (deadline-from release) (priority 1) (uses console.write))
  (platform (uses host.p)))
