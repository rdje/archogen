(eadl-version eadl/1)
; A handler naming a block an unrelated service is bound to: the same lines as unbound (§2.6; round 19, R3).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defblock console.uart
  (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e console.uart)))
(defservice console.write
  (requires (needs observable-output)))
(defservice evt
  (requires (needs interrupt-source) (uses console.uart)))
(defsystem hcb
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1))
  (requires (uses evt console.write))
  (platform (uses soc)))
