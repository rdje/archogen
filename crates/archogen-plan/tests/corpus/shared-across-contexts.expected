== system sac
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system sac)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task sac p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses console.write))
(bind console.write observable-output console.uart)
(bind evt interrupt-source dev.e)
(timer simulator (releases (task sac p)))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(node console.uart block)
(node console.write service)
(node dev.e block)
(node evt service)
(context (task sac p) job)
(context console.uart job (interrupt (source dev.e)) initialisation)
(context console.write job (interrupt (source dev.e)) initialisation)
(context dev.e (interrupt (source dev.e)) initialisation)
(context evt (interrupt (source dev.e)) initialisation)
(depends console.uart console.write (because (binding observable-output)))
(depends console.write evt (because named))
(depends dev.e evt (because (binding interrupt-source)))
(step 1 console.uart)
(step 2 console.write)
(step 3 dev.e)
(step 4 evt)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
