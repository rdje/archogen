(eadl-version eadl/1)
; A sporadic task stating a zero separation, its source stating one too: refused (§1; round 8, D4).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 0 ms) (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e)))
(defservice evt
  (requires (needs interrupt-source)))
(defsystem zs
  (task s (min-separation 0 ms) (deadline 0 ms) (deadline-from release) (priority 1) (uses evt))
  (platform (uses soc.e)))
