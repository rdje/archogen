== system ds
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ds)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ds s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source dev.e every)) (uses handler))
(task 1 (task ds p) (rank 2) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses log))
(bind evt interrupt-source dev.e)
(bind log observable-output console.uart)
(timer simulator (releases (task ds p)))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(node console.uart block)
(node dev.e block)
(node evt service)
(node handler service)
(node log service)
(context (task ds p) job)
(context (task ds s) job)
(context console.uart job (interrupt (source dev.e)) initialisation)
(context dev.e job (interrupt (source dev.e)) initialisation)
