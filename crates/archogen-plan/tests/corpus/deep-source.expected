(context log job (interrupt (source dev.e)) initialisation)
(depends console.uart log (because (binding observable-output)))
(depends dev.e evt (because (binding interrupt-source)))
(depends evt handler (because named))
(depends log evt (because named))
(step 1 console.uart)
(step 2 dev.e)
(step 3 log)
(step 4 evt)
(step 5 handler)
