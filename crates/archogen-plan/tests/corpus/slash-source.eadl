(eadl-version eadl/1)
; A service named `sl/a`, a legal symbol, handling dev.e's interrupts, which the periodic task `a` of system `sl`
; uses: a task's name is `(task sl a)`, so the two never collide (`M4.1.11`; round 9, D1).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e)))
(defservice sl/a
  (requires (needs interrupt-source)))
(defsystem sl
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses sl/a))
  (platform (uses soc.e)))
