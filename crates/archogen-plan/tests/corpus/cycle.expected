== system cyc
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system cyc)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task cyc t) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses log.write))
(bind log.write observable-output timer.counter)
(bind time.monotonic counter-width timer.counter)
(timer simulator (releases (task cyc t)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task cyc t) job)
(context log.write job initialisation)
(context time.monotonic job initialisation)
(context timer.counter job initialisation)
(depends log.write time.monotonic (because named))
(depends time.monotonic log.write (because named))
(depends timer.counter log.write (because (binding observable-output)))
(depends timer.counter time.monotonic (because (binding counter-width)))
(step 1 timer.counter)
(step 2 log.write time.monotonic)
(owed (task cyc t) entry-point (by application))
(owed (task cyc t) execution-bound (by application))
(owed (task cyc t) execution-category (by application))
(owed (task cyc t) figures-under-preemption (by application))
(owed (task cyc t) masked-category (by application))
(owed (task cyc t) masked-runs (by application))
(owed (task cyc t) masks-only-through-api (by application))
(owed (task cyc t) os-calls (by application))
(owed (task cyc t) os-calls-category (by application))
(owed (task cyc t) stack-bound (by application))
(owed (task cyc t) stack-category (by application))
(owed (task cyc t) task-facts (by application))
(owed cyc leaves-interrupt-hardware-alone (by application))
