== system pu
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system pu)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task pu a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses alarm))
(task 1 (task pu b) (rank 2) (period 1/50 s) (deadline 1/50 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses watchdog))
(bind alarm relative-delay timer.d)
(timer simulator (releases (task pu a) (task pu b)))
(route 1 (timer-route timer.d) (separation programmed) (level machine) (deliverable yes) (requesters alarm) (costs))
(enabled timer (timer-route timer.d))
(interrupt-model (nesting no) (masking all))
(context (task pu a) job)
(context (task pu b) job)
(context alarm job (interrupt (timer-route timer.d)) initialisation)
(context timer.d job (interrupt (timer-route timer.d)) initialisation)
(context watchdog job initialisation)
(depends alarm watchdog (because named))
(depends timer.d alarm (because (binding relative-delay)))
(step 1 timer.d)
(step 2 alarm)
(step 3 watchdog)
