== system sp
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system sp)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task sp s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by unknown) (uses pol))
(bind evt interrupt-source dev.e)
(timer simulator (releases))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task sp s) job)
(context dev.e job (interrupt (source dev.e)) initialisation)
(context evt (interrupt (source dev.e)) initialisation)
(context pol job initialisation)
(depends dev.e evt (because (binding interrupt-source)))
(depends dev.e pol (because named))
(step 1 dev.e)
(step 2 evt)
(step 3 pol)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task sp s) entry-point (by application))
(owed (task sp s) execution-bound (by application))
(owed (task sp s) execution-category (by application))
(owed (task sp s) figures-under-preemption (by application))
(owed (task sp s) masked-category (by application))
(owed (task sp s) masked-runs (by application))
(owed (task sp s) masks-only-through-api (by application))
(owed (task sp s) os-calls (by application))
(owed (task sp s) os-calls-category (by application))
(owed (task sp s) stack-bound (by application))
(owed (task sp s) stack-category (by application))
(owed (task sp s) task-facts (by application))
(owed (task sp s) trigger (by description))
(owed dev.e call-cost (by realization))
(owed dev.e contexts (by realization))
(owed dev.e masked-runs (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed evt contexts (by realization))
(owed evt no-wait (by realization))
(owed evt runtime-discipline (by realization))
(owed pol call-cost (by realization))
(owed pol contexts (by realization))
(owed pol masked-runs (by realization))
(owed pol no-wait (by realization))
(owed pol runtime-discipline (by realization))
(owed sp leaves-interrupt-hardware-alone (by application))
(complete no)
