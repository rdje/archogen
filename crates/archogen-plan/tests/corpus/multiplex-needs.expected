== system muxn
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system muxn)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task muxn a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses alarm))
(task 1 (task muxn b) (rank 2) (period 1/50 s) (deadline 1/50 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses alarm))
(bind alarm relative-delay timer.d)
(timer simulator (releases (task muxn a) (task muxn b)))
(route 1 (timer-route timer.d) (separation programmed) (level machine) (deliverable yes) (requesters alarm) (costs))
(enabled timer (timer-route timer.d))
(interrupt-model (nesting no) (masking all))
(context (task muxn a) job)
(context (task muxn b) job)
