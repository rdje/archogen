(eadl-version eadl/1)
; A system with no task: refused, the scheduler having no empty form (§1; round 7, D6).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e)))
(defservice evt
  (requires (needs interrupt-source)))
(defsystem empty
  (requires (uses evt))
  (platform (uses soc.e)))
