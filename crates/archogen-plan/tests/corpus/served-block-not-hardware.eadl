(eadl-version eadl/1)
; A block a service names, served but not the system's hardware, bound for requirements of its own: a node (§2; round
; 13, remark 2).
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defblock blk
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (needs observable-output)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses console.uart)))
(defservice drv (requires (uses blk)))
(defsystem sb
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses drv))
  (platform (uses soc)))
