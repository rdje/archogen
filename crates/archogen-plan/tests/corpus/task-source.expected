== system ts
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ts)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ts s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source dev.e every)) (uses log))
(bind log observable-output console.uart)
(bind (task ts s) interrupt-source dev.e)
(timer simulator (releases))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters (task ts s)) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task ts s) job)
(context console.uart job initialisation)
(context dev.e job (interrupt (source dev.e)) initialisation)
(context log job initialisation)
(depends console.uart log (because (binding observable-output)))
(step 1 console.uart)
(step 2 dev.e)
(step 3 log)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task ts s) entry-point (by application))
(owed (task ts s) execution-bound (by application))
(owed (task ts s) execution-category (by application))
(owed (task ts s) figures-under-preemption (by application))
(owed (task ts s) masked-category (by application))
(owed (task ts s) masked-runs (by application))
(owed (task ts s) masks-only-through-api (by application))
(owed (task ts s) os-calls (by application))
(owed (task ts s) os-calls-category (by application))
(owed (task ts s) stack-bound (by application))
(owed (task ts s) stack-category (by application))
(owed (task ts s) task-facts (by application))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart masked-runs (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed dev.e call-cost (by realization))
(owed dev.e contexts (by realization))
(owed dev.e masked-runs (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed log call-cost (by realization))
(owed log contexts (by realization))
(owed log masked-runs (by realization))
(owed log no-wait (by realization))
(owed log runtime-discipline (by realization))
(owed ts leaves-interrupt-hardware-alone (by application))
(complete no)
