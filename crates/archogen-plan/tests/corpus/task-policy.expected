== system tp
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system tp)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task tp a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses trace))
(bind trace observable-output console.uart)
(timer simulator (releases (task tp a)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task tp a) job)
(context console.uart job initialisation)
(context trace job initialisation)
(depends console.uart trace (because (binding observable-output)))
(step 1 console.uart)
(step 2 trace)
(owed (task tp a) entry-point (by application))
(owed (task tp a) execution-bound (by application))
(owed (task tp a) execution-category (by application))
(owed (task tp a) figures-under-preemption (by application))
(owed (task tp a) masked-category (by application))
(owed (task tp a) masked-runs (by application))
(owed (task tp a) masks-only-through-api (by application))
(owed (task tp a) os-calls (by application))
(owed (task tp a) os-calls-category (by application))
(owed (task tp a) stack-bound (by application))
(owed (task tp a) stack-category (by application))
(owed (task tp a) task-facts (by application))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart masked-runs (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed tp leaves-interrupt-hardware-alone (by application))
(owed trace call-cost (by realization))
