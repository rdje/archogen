(eadl-version eadl/1)
; A source stating a separation of 1e-38 ns, past the exact arithmetic in seconds: refused, never written `unknown`
; (§1, §2.5; round 10, D2).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 0.00000000000000000000000000000000000001 ns)
    (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e)))
(defservice evt (requires (needs interrupt-source)))
(defsystem ts
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1))
  (requires (uses evt))
  (platform (uses soc.e)))
