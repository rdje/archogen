(eadl-version eadl/1)
; A platform raising a source and composing the console: composition is no call, so the console runs in no interrupt
; of the platform's (§2; round 12, D4).
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine))
  (requires (uses console.uart)))
(defservice evt (requires (needs interrupt-source)))
(defservice log (requires (needs observable-output)))
(defsystem pcmp
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1))
  (requires (uses evt log))
  (platform (uses soc.e)))
