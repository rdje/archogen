== system s
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system s)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task s a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses w))
(bind outp relative-delay tmr)
(bind tmr observable-output outp)
(bind w observable-output outp)
(timer simulator (releases (task s a)))
(route 1 (timer-route tmr) (separation programmed) (level machine) (deliverable yes) (requesters outp) (costs))
(enabled timer (timer-route tmr))
(interrupt-model (nesting no) (masking all))
(context (task s a) job)
