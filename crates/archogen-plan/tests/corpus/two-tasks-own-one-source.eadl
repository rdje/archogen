(eadl-version eadl/1)
; Two sporadic tasks bound themselves to one source, as far apart as one and released less often than it by the
; other: `(source … every)` and `(unknown (own-faster …))` (§2.2; round 28, R4).
(defblock dev.x
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.x)))
(defsystem two
  (task t (min-separation 20 ms) (deadline 20 ms) (deadline-from release) (priority 1) (needs interrupt-source))
  (task u (min-separation 40 ms) (deadline 40 ms) (deadline-from release) (priority 2) (needs interrupt-source))
  (platform (uses soc)))
