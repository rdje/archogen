== system pcmp
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system pcmp)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task pcmp p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses))
(bind evt interrupt-source soc.e)
(bind log observable-output console.uart)
(timer simulator (releases (task pcmp p)))
(route 1 (source soc.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source soc.e))
(interrupt-model (nesting no) (masking all))
(context (task pcmp p) job)
(context console.uart initialisation)
(context evt (interrupt (source soc.e)) initialisation)
(context log initialisation)
(context soc.e (interrupt (source soc.e)) initialisation)
(depends console.uart log (because (binding observable-output)))
(depends soc.e evt (because (binding interrupt-source)))
(step 1 console.uart)
(step 2 log)
(step 3 soc.e)
(step 4 evt)
(obligation route (source soc.e) (discharged-by M4.2 M4.3))
(owed (source soc.e) acknowledge-point (by realization))
(owed (source soc.e) deferred-work (by realization))
(owed (source soc.e) no-application-code (by realization))
(owed (source soc.e) one-request-per-arrival (by realization))
(owed (source soc.e) service-cost (by realization))
(owed (task pcmp p) entry-point (by application))
(owed (task pcmp p) execution-bound (by application))
(owed (task pcmp p) execution-category (by application))
(owed (task pcmp p) figures-under-preemption (by application))
(owed (task pcmp p) masked-category (by application))
(owed (task pcmp p) masked-runs (by application))
(owed (task pcmp p) masks-only-through-api (by application))
(owed (task pcmp p) os-calls (by application))
(owed (task pcmp p) stack-bound (by application))
(owed (task pcmp p) stack-category (by application))
(owed (task pcmp p) task-facts (by application))
(owed console.uart contexts (by realization))
(owed console.uart no-wait (by realization))
(owed evt contexts (by realization))
(owed evt no-wait (by realization))
(owed log contexts (by realization))
(owed log no-wait (by realization))
(owed pcmp leaves-interrupt-hardware-alone (by application))
(owed soc.e contexts (by realization))
(owed soc.e no-wait (by realization))
(complete no)
