(eadl-version eadl/1)
; A block requiring an absolute deadline that nothing binds to: a node, its instance's expiry running its code (§2,
; §2.6; `M4.1.15`, round 12, D1).
; It offers what the system asks, so it may be bound and its needs are the search's (`M3.4.17.6`).
(defblock timer.d
  (offers (relative-delay true) (counter-modulus 65536) (tick-rate 10 MHz) (observation-coherent true)
    (channels 2 tick) (reachable-at-privilege machine)))
(defblock dma.x
  (offers debug-port (reachable-at-privilege machine))
  (requires (needs absolute-deadline)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses timer.d dma.x)))
(defsystem be
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1))
  (requires (needs debug-port))
  (platform (uses soc)))
