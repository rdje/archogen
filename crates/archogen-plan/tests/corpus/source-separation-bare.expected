== system sb
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system sb)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task sb s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by unknown) (uses evt))
(bind evt interrupt-source dev.e)
(timer simulator (releases))
(route 1 (source dev.e) (separation unknown) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task sb s) job)
(context dev.e job (interrupt (source dev.e)) initialisation)
(context evt job (interrupt (source dev.e)) initialisation)
(depends dev.e evt (because (binding interrupt-source)))
(step 1 dev.e)
(step 2 evt)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) separation (by description))
(owed (source dev.e) service-cost (by realization))
(owed (task sb s) entry-point (by application))
(owed (task sb s) execution-bound (by application))
(owed (task sb s) execution-category (by application))
(owed (task sb s) figures-under-preemption (by application))
(owed (task sb s) masked-category (by application))
(owed (task sb s) masked-runs (by application))
(owed (task sb s) masks-only-through-api (by application))
(owed (task sb s) os-calls (by application))
(owed (task sb s) stack-bound (by application))
(owed (task sb s) stack-category (by application))
(owed (task sb s) task-facts (by application))
(owed (task sb s) trigger (by description))
(owed dev.e call-cost (by realization))
(owed dev.e contexts (by realization))
(owed dev.e masked-runs (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed evt call-cost (by realization))
(owed evt contexts (by realization))
(owed evt masked-runs (by realization))
(owed evt no-wait (by realization))
(owed evt runtime-discipline (by realization))
(owed sb leaves-interrupt-hardware-alone (by application))
(complete no)
