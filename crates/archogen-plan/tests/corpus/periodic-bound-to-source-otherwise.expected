== system pb
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system pb)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task pb p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses))
(bind (task pb p) observable-output dev.e)
(timer simulator (releases (task pb p)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task pb p) job)
(context dev.e job initialisation)
(step 1 dev.e)
(owed (task pb p) entry-point (by application))
(owed (task pb p) execution-bound (by application))
(owed (task pb p) execution-category (by application))
(owed (task pb p) figures-under-preemption (by application))
(owed (task pb p) masked-category (by application))
(owed (task pb p) masked-runs (by application))
(owed (task pb p) masks-only-through-api (by application))
(owed (task pb p) os-calls (by application))
(owed (task pb p) stack-bound (by application))
(owed (task pb p) stack-category (by application))
(owed (task pb p) task-facts (by application))
(owed dev.e call-cost (by realization))
(owed dev.e contexts (by realization))
(owed dev.e masked-category (by realization))
(owed dev.e masked-runs (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed pb leaves-interrupt-hardware-alone (by application))
(complete no)
