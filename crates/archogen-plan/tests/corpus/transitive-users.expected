== system tu
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system tu)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task tu a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses logger))
(task 1 (task tu b) (rank 2) (period 1/50 s) (deadline 1/50 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses logger))
(bind alarm relative-delay timer.d)
(bind logger observable-output console.uart)
(timer simulator (releases (task tu a) (task tu b)))
