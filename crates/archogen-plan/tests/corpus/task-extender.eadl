(eadl-version eadl/1)
; A sporadic task served by an epoch extender directly: the timer route names the task.
(defblock timer.short
  (offers
    (relative-delay true)
    (counter-modulus 65536)
    (tick-rate 10 MHz)
    (wrap-behavior modular)
    (observation-coherent true)
    (channels 1 tick)
    (reachable-at-privilege machine)))
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform soc.short
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.short dev.e)))
(defsystem te
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1)
    (needs interrupt-source counter-width tick-rate observation-coherent))
  (platform (uses soc.short)))
