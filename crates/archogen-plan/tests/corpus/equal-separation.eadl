(eadl-version eadl/1)
; A source whose separation equals its task's: every arrival releases it (§2.2; round 9).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e)))
(defservice evt
  (requires (needs interrupt-source)))
(defsystem eq
  (task s (min-separation 20 ms) (deadline 20 ms) (deadline-from release) (priority 1) (uses evt))
  (platform (uses soc.e)))
