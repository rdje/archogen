(eadl-version eadl/1)
; A block writing only a level requirement, which binds nothing: no node (§2; round 13, D2).
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defblock nic
  (offers (transfer-engine true) (reachable-at-privilege machine))
  (requires (reachable-at-privilege machine)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses console.uart nic)))
(defservice log (requires (needs observable-output)))
(defsystem wb
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses log))
  (platform (uses soc)))
