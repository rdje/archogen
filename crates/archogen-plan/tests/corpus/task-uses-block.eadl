(eadl-version eadl/1)
; A task naming a block by `uses`: §2.2's `(uses …)` holds services and policies alone, its `bind` lines saying what
; it is bound to (round 7, D4).
(defblock console.uart
  (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform host.p
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses console.uart)))
(defservice console.write
  (requires (needs observable-output)))
(defsystem tub
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses console.uart console.write))
  (platform (uses host.p)))
