== system td
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system td)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task td a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses))
(bind (task td a) observable-output console.uart)
(timer simulator (releases (task td a)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task td a) job)
(context console.uart job initialisation)
(step 1 console.uart)
(owed (task td a) entry-point (by application))
(owed (task td a) execution-bound (by application))
(owed (task td a) execution-category (by application))
(owed (task td a) figures-under-preemption (by application))
(owed (task td a) masked-category (by application))
(owed (task td a) masked-runs (by application))
(owed (task td a) masks-only-through-api (by application))
(owed (task td a) os-calls (by application))
(owed (task td a) stack-bound (by application))
(owed (task td a) stack-category (by application))
(owed (task td a) task-facts (by application))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed td leaves-interrupt-hardware-alone (by application))
(complete no)
