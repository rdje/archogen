(eadl-version eadl/1)
; A sporadic task reaching no source, bound itself to the system's one source, faster than the task:
; `(unknown (own-faster …))` (§2.2, `RTP-H24`; round 27, D1).
(defblock dev.a
  (offers (interrupt-source true) (min-arrival-separation 5 ms) (reachable-at-privilege machine)))
(defblock console.uart
  (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.a console.uart)))
(defservice log
  (requires (needs observable-output)))
(defsystem su
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (needs interrupt-source) (uses log))
  (platform (uses soc)))
