(eadl-version eadl/1)
; A policy handling a source's interrupts (round 9).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e)))
(defpolicy evtp
  (requires (needs interrupt-source)))
(defsystem ph
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses evtp))
  (platform (uses soc.e)))
