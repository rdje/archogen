(eadl-version eadl/1)
; Two tasks programming alarms at two timers: the refusal names both in runtime order (§1; round 11, D1).
(defblock timer.a
  (offers (relative-delay true) (channels 1 tick) (reachable-at-privilege machine)))
(defblock timer.z
  (offers (relative-delay true) (channels 1 tick) (reachable-at-privilege machine)))
(defplatform soc.d (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses timer.a timer.z)))
(defsystem ord3
  (task a (period 20 ms) (deadline 20 ms) (deadline-from release) (priority 2) (needs relative-delay))
  (task b (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (needs relative-delay))
  (platform (uses soc.d)))
