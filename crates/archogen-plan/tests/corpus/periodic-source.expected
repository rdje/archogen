== system ps
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ps)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ps p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses interrupt-source))
(bind (task ps p) interrupt-source dev.e)
(timer simulator (releases (task ps p)))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters (task ps p)) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task ps p) job)
(context dev.e job (interrupt (source dev.e)) initialisation)
(step 1 dev.e)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task ps p) entry-point (by application))
(owed (task ps p) execution-bound (by application))
(owed (task ps p) execution-category (by application))
(owed (task ps p) masked-runs (by application))
(owed (task ps p) os-calls (by application))
(owed (task ps p) stack-bound (by application))
(owed (task ps p) stack-category (by application))
(owed (task ps p) task-facts (by application))
(owed dev.e call-cost (by realization))
(owed dev.e contexts (by realization))
(owed dev.e no-wait (by realization))
(owed ps leaves-interrupt-hardware-alone (by application))
(complete no)
