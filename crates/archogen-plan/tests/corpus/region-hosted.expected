== system reg
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system reg)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task reg t) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses console.write))
(bind console.write observable-output console.uart)
(timer simulator (releases (task reg t)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task reg t) job)
(context console.uart job initialisation)
(context console.write job initialisation)
(depends console.uart console.write (because (binding observable-output)))
(step 1 console.uart)
(step 2 console.write)
(owed (task reg t) entry-point (by application))
(owed (task reg t) execution-bound (by application))
(owed (task reg t) execution-category (by application))
(owed (task reg t) masked-runs (by application))
(owed (task reg t) os-calls (by application))
(owed (task reg t) stack-bound (by application))
(owed (task reg t) stack-category (by application))
(owed (task reg t) task-facts (by application))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart no-wait (by realization))
(owed console.write call-cost (by realization))
(owed console.write contexts (by realization))
(owed console.write no-wait (by realization))
(owed reg leaves-interrupt-hardware-alone (by application))
(complete no)
