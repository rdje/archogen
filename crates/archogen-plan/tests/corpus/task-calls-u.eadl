(eadl-version eadl/1)
; `task-calls-t` with `u` naming `blk` instead: the plans differ in which task's `uses` lists it (§2.2; round 24, D1).
(defblock blk
  (offers (transfer-engine true) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses blk)))
(defsystem call
  (task t (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1))
  (task u (period 20 ms) (deadline 20 ms) (deadline-from release) (priority 2) (uses blk))
  (platform (uses soc)))
