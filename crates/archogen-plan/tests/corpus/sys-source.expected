== system ss
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ss)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ss s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (unknown unreached)) (uses log))
(bind log observable-output console.uart)
(bind ss interrupt-source dev.e)
(timer simulator (releases))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters ss) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(node console.uart block)
(node dev.e block)
(node log service)
(context (task ss s) job)
(context console.uart job initialisation)
(context dev.e (interrupt (source dev.e)) initialisation)
(context log job initialisation)
(depends console.uart log (because (binding observable-output)))
(step 1 console.uart)
(step 2 dev.e)
(step 3 log)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task ss s) entry-point (by application))
(owed (task ss s) execution-bound (by application))
(owed (task ss s) execution-category (by application))
(owed (task ss s) figures-under-preemption (by application))
(owed (task ss s) masked-category (by application))
(owed (task ss s) masked-runs (by application))
(owed (task ss s) masks-only-through-api (by application))
(owed (task ss s) os-calls (by application))
(owed (task ss s) os-calls-category (by application))
(owed (task ss s) stack-bound (by application))
(owed (task ss s) stack-category (by application))
(owed (task ss s) task-facts (by application))
(owed (task ss s) trigger (by description))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart masked-runs (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed dev.e contexts (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed log call-cost (by realization))
(owed log contexts (by realization))
(owed log masked-runs (by realization))
(owed log no-wait (by realization))
(owed log runtime-discipline (by realization))
(owed ss leaves-interrupt-hardware-alone (by application))
(complete no)
