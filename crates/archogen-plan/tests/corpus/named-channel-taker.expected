== system nc
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system nc)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task nc p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses))
(bind ctl relative-delay timer.d)
(bind evt interrupt-source dev.a)
(timer simulator (releases (task nc p)))
(route 1 (source dev.a) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(route 2 (timer-route timer.d) (separation programmed) (level machine) (deliverable yes) (requesters ctl) (costs))
(enabled timer (source dev.a) (timer-route timer.d))
(interrupt-model (nesting no) (masking all))
(context (task nc p) job)
(context ctl job (interrupt (source dev.a)) (interrupt (timer-route timer.d)) initialisation)
(context dev.a (interrupt (source dev.a)) initialisation)
(context evt (interrupt (source dev.a)) initialisation)
(context timer.d job (interrupt (source dev.a)) (interrupt (timer-route timer.d)) initialisation)
(depends ctl evt (because named))
(depends dev.a evt (because (binding interrupt-source)))
(depends timer.d ctl (because (binding relative-delay)))
(step 1 dev.a)
(step 2 timer.d)
(step 3 ctl)
(step 4 evt)
(obligation multiplex ctl (discharged-by M4.2 M2.21.2))
(obligation route (source dev.a) (discharged-by M4.2 M4.3))
(obligation route (timer-route timer.d) (discharged-by M4.2 M4.3))
(owed (source dev.a) acknowledge-point (by realization))
(owed (source dev.a) deferred-work (by realization))
(owed (source dev.a) no-application-code (by realization))
(owed (source dev.a) one-request-per-arrival (by realization))
(owed (source dev.a) service-cost (by realization))
(owed (task nc p) entry-point (by application))
(owed (task nc p) execution-bound (by application))
(owed (task nc p) execution-category (by application))
(owed (task nc p) figures-under-preemption (by application))
(owed (task nc p) masked-category (by application))
(owed (task nc p) masked-runs (by application))
(owed (task nc p) masks-only-through-api (by application))
(owed (task nc p) os-calls (by application))
(owed (task nc p) os-calls-category (by application))
(owed (task nc p) stack-bound (by application))
(owed (task nc p) stack-category (by application))
(owed (task nc p) task-facts (by application))
(owed (timer-route timer.d) arrival-bound (by realization))
(owed (timer-route timer.d) service-cost (by realization))
(owed ctl call-cost (by realization))
(owed ctl contexts (by realization))
(owed ctl masked-runs (by realization))
(owed ctl no-wait (by realization))
(owed ctl overhead (by realization))
(owed ctl runtime-discipline (by realization))
(owed dev.a contexts (by realization))
(owed dev.a no-wait (by realization))
(owed dev.a runtime-discipline (by realization))
(owed evt contexts (by realization))
(owed evt no-wait (by realization))
(owed evt runtime-discipline (by realization))
(owed nc leaves-interrupt-hardware-alone (by application))
(owed timer.d call-cost (by realization))
(owed timer.d contexts (by realization))
(owed timer.d masked-runs (by realization))
(owed timer.d no-wait (by realization))
(owed timer.d runtime-discipline (by realization))
(complete no)
