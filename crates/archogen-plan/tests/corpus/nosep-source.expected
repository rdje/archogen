== system ns
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ns)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ns u) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by unknown) (uses nosep))
(bind nosep interrupt-source dev.g)
(timer simulator (releases))
(route 1 (source dev.g) (separation unknown) (level machine) (deliverable yes) (requesters nosep) (costs))
(enabled timer (source dev.g))
(interrupt-model (nesting no) (masking all))
(context (task ns u) job)
(context dev.g job (interrupt (source dev.g)) initialisation)
(context nosep job (interrupt (source dev.g)) initialisation)
(depends dev.g nosep (because (binding interrupt-source)))
(step 1 dev.g)
(step 2 nosep)
(obligation route (source dev.g) (discharged-by M4.2 M4.3))
(owed (source dev.g) acknowledge-point (by realization))
(owed (source dev.g) deferred-work (by realization))
(owed (source dev.g) no-application-code (by realization))
(owed (source dev.g) one-request-per-arrival (by realization))
(owed (source dev.g) separation (by description))
(owed (source dev.g) service-cost (by realization))
(owed (task ns u) entry-point (by application))
(owed (task ns u) execution-bound (by application))
(owed (task ns u) execution-category (by application))
(owed (task ns u) figures-under-preemption (by application))
(owed (task ns u) masked-category (by application))
(owed (task ns u) masked-runs (by application))
(owed (task ns u) masks-only-through-api (by application))
(owed (task ns u) os-calls (by application))
(owed (task ns u) stack-bound (by application))
(owed (task ns u) stack-category (by application))
(owed (task ns u) task-facts (by application))
(owed (task ns u) trigger (by description))
(owed dev.g call-cost (by realization))
(owed dev.g contexts (by realization))
(owed dev.g no-wait (by realization))
(owed dev.g runtime-discipline (by realization))
(owed nosep call-cost (by realization))
(owed nosep contexts (by realization))
(owed nosep no-wait (by realization))
(owed nosep runtime-discipline (by realization))
(owed ns leaves-interrupt-hardware-alone (by application))
(complete no)
