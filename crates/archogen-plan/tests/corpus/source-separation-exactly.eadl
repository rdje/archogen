(eadl-version eadl/1)
; A source offering its separation `exactly`, which the relation reads as a value: `(source … every)` (§2.5; round 30,
; R2).
(defblock src.e
  (offers (interrupt-source true) (min-arrival-separation (exactly 20 ms)) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses src.e)))
(defservice evt
  (requires (needs interrupt-source)))
(defsystem bs
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses evt))
  (platform (uses soc)))
