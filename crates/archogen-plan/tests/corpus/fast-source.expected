== system fs
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system fs)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task fs s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by unknown) (uses fast))
(bind fast interrupt-source dev.f)
(timer simulator (releases))
(route 1 (source dev.f) (separation 1/200 s) (level machine) (deliverable yes) (requesters fast) (costs))
(enabled timer (source dev.f))
(interrupt-model (nesting no) (masking all))
(context (task fs s) job)
(context dev.f job (interrupt (source dev.f)) initialisation)
(context fast job (interrupt (source dev.f)) initialisation)
(depends dev.f fast (because (binding interrupt-source)))
(step 1 dev.f)
(step 2 fast)
(obligation route (source dev.f) (discharged-by M4.2 M4.3))
(owed (source dev.f) acknowledge-point (by realization))
(owed (source dev.f) deferred-work (by realization))
(owed (source dev.f) no-application-code (by realization))
(owed (source dev.f) one-request-per-arrival (by realization))
(owed (source dev.f) service-cost (by realization))
(owed (task fs s) entry-point (by application))
(owed (task fs s) execution-bound (by application))
(owed (task fs s) execution-category (by application))
(owed (task fs s) figures-under-preemption (by application))
(owed (task fs s) masked-category (by application))
(owed (task fs s) masked-runs (by application))
(owed (task fs s) masks-only-through-api (by application))
(owed (task fs s) os-calls (by application))
(owed (task fs s) stack-bound (by application))
(owed (task fs s) stack-category (by application))
(owed (task fs s) task-facts (by application))
(owed (task fs s) trigger (by description))
(owed dev.f call-cost (by realization))
(owed dev.f contexts (by realization))
(owed dev.f masked-category (by realization))
(owed dev.f masked-runs (by realization))
(owed dev.f no-wait (by realization))
(owed dev.f runtime-discipline (by realization))
(owed fast call-cost (by realization))
(owed fast contexts (by realization))
(owed fast masked-category (by realization))
(owed fast masked-runs (by realization))
(owed fast no-wait (by realization))
(owed fast runtime-discipline (by realization))
(owed fs leaves-interrupt-hardware-alone (by application))
(complete no)
