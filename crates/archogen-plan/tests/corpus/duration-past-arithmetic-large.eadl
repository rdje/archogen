(eadl-version eadl/1)
; A duration of 9223372036854775807.9223372036854775807 s: within the arithmetic or refused, never read as no time
; (§2.2; round 10, D2).
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform host.p (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses console.uart)))
(defservice console.write (requires (needs observable-output)))
(defsystem du
  (task a (period 10 ms) (deadline 10 ms) (jitter 9223372036854775807.9223372036854775807 s) (deadline-from release) (priority 1) (uses console.write))
  (platform (uses host.p)))
