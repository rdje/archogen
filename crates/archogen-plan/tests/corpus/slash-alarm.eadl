(eadl-version eadl/1)
; A service named `sl/a` taking an alarm: a service, never a task programming one (`M4.1.11`; round 9).
(defblock timer.d
  (offers (relative-delay true) (channels 1 tick) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.d)))
(defservice sl/a
  (requires (needs relative-delay)))
(defsystem sl
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses sl/a))
  (platform (uses soc)))
