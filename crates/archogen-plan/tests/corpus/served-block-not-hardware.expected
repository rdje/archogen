== system sb
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system sb)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task sb p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses drv))
(bind blk observable-output console.uart)
(timer simulator (releases (task sb p)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task sb p) job)
(context blk job initialisation)
(context console.uart job initialisation)
(context drv job initialisation)
(depends blk drv (because named))
(depends console.uart blk (because (binding observable-output)))
(step 1 console.uart)
(step 2 blk)
(step 3 drv)
(owed (task sb p) entry-point (by application))
(owed (task sb p) execution-bound (by application))
(owed (task sb p) execution-category (by application))
(owed (task sb p) figures-under-preemption (by application))
(owed (task sb p) masked-category (by application))
(owed (task sb p) masked-runs (by application))
(owed (task sb p) masks-only-through-api (by application))
(owed (task sb p) os-calls (by application))
(owed (task sb p) stack-bound (by application))
(owed (task sb p) stack-category (by application))
(owed (task sb p) task-facts (by application))
(owed blk call-cost (by realization))
(owed blk contexts (by realization))
(owed blk masked-category (by realization))
(owed blk masked-runs (by realization))
(owed blk no-wait (by realization))
(owed blk runtime-discipline (by realization))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart masked-category (by realization))
(owed console.uart masked-runs (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed drv call-cost (by realization))
(owed drv contexts (by realization))
(owed drv masked-category (by realization))
(owed drv masked-runs (by realization))
(owed drv no-wait (by realization))
(owed drv runtime-discipline (by realization))
(owed sb leaves-interrupt-hardware-alone (by application))
(complete no)
