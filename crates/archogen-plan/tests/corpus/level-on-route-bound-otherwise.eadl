(eadl-version eadl/1)
; Round 15: The system's own level, which the timer route at timer.short names (through the extender it binds its
; counter facts to), bound to timer.short itself for a fact that is not consumed (observable-output): §1 refuses such a
; level only where it is "bound to its provider itself by a binding that takes a channel", which this binding is not, so
; the plan is written; §2.6 runs no code of it there either way.
(defblock timer.short
  (offers
    (relative-delay true)
    (counter-modulus 65536)
    (tick-rate 10 MHz)
    (wrap-behavior modular)
    (observation-coherent true)
    (observable-output true)
    (channels 1 tick)
    (reachable-at-privilege machine)))
(defplatform soc.short
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.short)))
(defsystem lx
  (task s (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1))
  (requires (needs counter-width tick-rate observation-coherent observable-output))
  (platform (uses soc.short)))
