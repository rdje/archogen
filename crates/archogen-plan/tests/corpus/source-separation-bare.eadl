(eadl-version eadl/1)
; A source offering its separation bare: `unknown`, owed to the description (§2.5; round 12).
(defblock dev.e (offers (interrupt-source true) (min-arrival-separation) (reachable-at-privilege machine)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses dev.e)))
(defservice evt (requires (needs interrupt-source)))
(defsystem sb
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses evt))
  (platform (uses soc)))
