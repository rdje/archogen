(eadl-version eadl/1)
; A sporadic task released through a block that handles a source (§2.2; round 12).
(defblock dev.e (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defblock nic (offers (observable-output true) (reachable-at-privilege machine)) (requires (needs interrupt-source)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses dev.e nic)))
(defservice out (requires (needs observable-output)))
(defsystem bt
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses out))
  (platform (uses soc)))
