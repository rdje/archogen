(eadl-version eadl/1)
; Two tasks naming one alarm service by `needs`: the joint rules count `uses` users alone.
(defblock timer.d
  (offers (relative-delay true) (channels 1 tick) (reachable-at-privilege machine)))
(defplatform soc.m
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.d)))
(defservice alarm
  (requires (needs relative-delay)))
(defsystem muxn
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (needs alarm))
  (task b (period 20 ms) (deadline 20 ms) (deadline-from release) (priority 2) (needs alarm))
  (platform (uses soc.m)))
