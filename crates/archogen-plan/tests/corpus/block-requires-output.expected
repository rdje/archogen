== system bo
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system bo)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task bo a) (rank 1) (min-separation 1/50 s) (deadline 1/50 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source logger.x every)) (uses evt))
(bind evt interrupt-source logger.x)
(bind logger.x observable-output console.uart)
(timer simulator (releases))
(route 1 (source logger.x) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source logger.x))
(interrupt-model (nesting no) (masking all))
(context (task bo a) job)
(context console.uart job (interrupt (source logger.x)) initialisation)
(context evt job (interrupt (source logger.x)) initialisation)
(context logger.x job (interrupt (source logger.x)) initialisation)
(depends console.uart logger.x (because (binding observable-output)))
(depends logger.x evt (because (binding interrupt-source)))
(step 1 console.uart)
(step 2 logger.x)
(step 3 evt)
(obligation route (source logger.x) (discharged-by M4.2 M4.3))
(owed (source logger.x) acknowledge-point (by realization))
(owed (source logger.x) deferred-work (by realization))
(owed (source logger.x) no-application-code (by realization))
(owed (source logger.x) one-request-per-arrival (by realization))
(owed (source logger.x) service-cost (by realization))
(owed (task bo a) entry-point (by application))
(owed (task bo a) execution-bound (by application))
(owed (task bo a) execution-category (by application))
(owed (task bo a) figures-under-preemption (by application))
(owed (task bo a) masked-category (by application))
(owed (task bo a) masked-runs (by application))
(owed (task bo a) masks-only-through-api (by application))
(owed (task bo a) os-calls (by application))
(owed (task bo a) stack-bound (by application))
(owed (task bo a) stack-category (by application))
(owed (task bo a) task-facts (by application))
(owed bo leaves-interrupt-hardware-alone (by application))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart no-wait (by realization))
(owed evt call-cost (by realization))
