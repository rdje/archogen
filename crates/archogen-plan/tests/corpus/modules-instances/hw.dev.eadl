(eadl-version eadl/1)
(defmodule hw.dev
  (version 1 0)
  (export dev.e timer.short soc)
  (defblock dev.e
    (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
  (defblock timer.short
    (offers (relative-delay true) (counter-width 16 bit) (counter-modulus 65536) (tick-rate 10 MHz)
      (wrap-behavior modular) (observation-coherent true) (channels 2 tick) (reachable-at-privilege machine)))
  (defplatform soc
    (offers (core-count 1 tick) (reachable-at-privilege machine))
    (requires (uses dev.e timer.short))))
