(instance (adapter deadline-over-delay hw.timer.short os.dl) (obliged delivery-bound 1/20000 s) (obligations delivery chain) (costs expiry))
(instance (adapter epoch-extender hw.timer.short) (obligations update coherent) (costs wake))
(timer simulator (releases (task app p)))
(route 1 (source hw.dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters os.evt) (costs))
(route 2 (timer-route hw.timer.short) (separation programmed) (level machine) (deliverable yes) (requesters os.dl os.time) (costs ((adapter deadline-over-delay hw.timer.short os.dl) expiry) ((adapter epoch-extender hw.timer.short) wake)))
(enabled timer (source hw.dev.e) (timer-route hw.timer.short))
(interrupt-model (nesting no) (masking all))
(node (adapter deadline-over-delay hw.timer.short os.dl) instance)
(node (adapter epoch-extender hw.timer.short) instance)
