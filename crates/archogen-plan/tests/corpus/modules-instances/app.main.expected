(context os.time job initialisation)
(depends (adapter deadline-over-delay hw.timer.short os.dl) os.dl (because (binding absolute-deadline)))
(depends (adapter epoch-extender hw.timer.short) os.time (because (binding counter-width) (binding observation-coherent) (binding tick-rate) (binding unambiguous-horizon)))
(depends hw.dev.e os.evt (because (binding interrupt-source)))
(depends hw.timer.short (adapter deadline-over-delay hw.timer.short os.dl) (because (binding counter-modulus) (binding observation-coherent) (binding relative-delay) (binding tick-rate)))
(depends hw.timer.short (adapter epoch-extender hw.timer.short) (because (binding counter-modulus) (binding observation-coherent) (binding relative-delay) (binding tick-rate) (binding wrap-behavior)))
