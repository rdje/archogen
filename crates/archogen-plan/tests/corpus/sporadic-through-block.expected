== system bt
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system bt)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task bt s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source dev.e every)) (uses out))
(bind nic interrupt-source dev.e)
(bind out observable-output nic)
(timer simulator (releases))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters nic) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task bt s) job)
(context dev.e job (interrupt (source dev.e)) initialisation)
(context nic job (interrupt (source dev.e)) initialisation)
(context out job initialisation)
(depends dev.e nic (because (binding interrupt-source)))
(depends nic out (because (binding observable-output)))
(step 1 dev.e)
(step 2 nic)
(step 3 out)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task bt s) entry-point (by application))
(owed (task bt s) execution-bound (by application))
(owed (task bt s) execution-category (by application))
(owed (task bt s) figures-under-preemption (by application))
(owed (task bt s) masked-category (by application))
(owed (task bt s) masked-runs (by application))
(owed (task bt s) masks-only-through-api (by application))
(owed (task bt s) os-calls (by application))
(owed (task bt s) stack-bound (by application))
(owed (task bt s) stack-category (by application))
(owed (task bt s) task-facts (by application))
(owed bt leaves-interrupt-hardware-alone (by application))
(owed dev.e call-cost (by realization))
(owed dev.e contexts (by realization))
(owed dev.e masked-category (by realization))
(owed dev.e masked-runs (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed nic call-cost (by realization))
(owed nic contexts (by realization))
(owed nic masked-category (by realization))
(owed nic masked-runs (by realization))
(owed nic no-wait (by realization))
(owed nic runtime-discipline (by realization))
(owed out call-cost (by realization))
(owed out contexts (by realization))
(owed out masked-category (by realization))
(owed out masked-runs (by realization))
(owed out no-wait (by realization))
(owed out runtime-discipline (by realization))
(complete no)
