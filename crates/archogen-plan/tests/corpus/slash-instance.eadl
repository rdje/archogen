(eadl-version eadl/1)
; A service named `sl/d` met by an exclusive `deadline-over-delay` instance: the instance serves `sl/d`, never a task
; (`M4.1.11`; round 9, D1).
(defblock timer.delay
  (offers (relative-delay true) (counter-modulus 4294967296) (tick-rate 1 MHz) (observation-coherent true)
    (channels 1 tick) (reachable-at-privilege machine)))
(defplatform soc.d
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.delay)))
(defservice sl/d
  (requires (needs absolute-deadline)))
(defsystem sl
  (task a (period 25 ms) (deadline 25 ms) (deadline-from release) (priority 1) (uses sl/d))
  (platform (uses soc.d)))
