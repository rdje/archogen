== system bn
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system bn)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task bn a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses))
(bind bn debug-port nic)
(bind nic interrupt-source dev.e)
(timer simulator (releases (task bn a)))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters nic) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(node dev.e block)
(node nic block)
(context (task bn a) job)
(context dev.e (interrupt (source dev.e)) initialisation)
(context nic (interrupt (source dev.e)) initialisation)
(depends dev.e nic (because (binding interrupt-source)))
(step 1 dev.e)
(step 2 nic)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task bn a) entry-point (by application))
(owed (task bn a) execution-bound (by application))
(owed (task bn a) execution-category (by application))
(owed (task bn a) figures-under-preemption (by application))
(owed (task bn a) masked-category (by application))
(owed (task bn a) masked-runs (by application))
(owed (task bn a) masks-only-through-api (by application))
(owed (task bn a) os-calls (by application))
(owed (task bn a) os-calls-category (by application))
(owed (task bn a) stack-bound (by application))
(owed (task bn a) stack-category (by application))
(owed (task bn a) task-facts (by application))
(owed bn leaves-interrupt-hardware-alone (by application))
(owed dev.e contexts (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed nic contexts (by realization))
(owed nic no-wait (by realization))
(owed nic runtime-discipline (by realization))
(complete no)
