(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system app)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task app s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source hw.dev.e every)) (uses evt))
(bind evt interrupt-source hw.dev.e)
(timer simulator (releases))
(route 1 (source hw.dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source hw.dev.e))
(interrupt-model (nesting no) (masking all))
(node evt service)
(node hw.dev.e block)
(node hw.serial block)
(context (task app s) job)
(context evt job (interrupt (source hw.dev.e)) initialisation)
(context hw.dev.e job (interrupt (source hw.dev.e)) initialisation)
(context hw.serial job (interrupt (source hw.dev.e)) initialisation)
(depends hw.dev.e evt (because (binding interrupt-source)))
(depends hw.serial evt (because named))
(step 1 hw.dev.e)
(step 2 hw.serial)
(step 3 evt)
(obligation route (source hw.dev.e) (discharged-by M4.2 M4.3))
(owed (source hw.dev.e) acknowledge-point (by realization))
(owed (source hw.dev.e) deferred-work (by realization))
(owed (source hw.dev.e) no-application-code (by realization))
(owed (source hw.dev.e) one-request-per-arrival (by realization))
(owed (source hw.dev.e) service-cost (by realization))
(owed (task app s) entry-point (by application))
(owed (task app s) execution-bound (by application))
(owed (task app s) execution-category (by application))
(owed (task app s) figures-under-preemption (by application))
(owed (task app s) masked-category (by application))
(owed (task app s) masked-runs (by application))
(owed (task app s) masks-only-through-api (by application))
(owed (task app s) os-calls (by application))
(owed (task app s) os-calls-category (by application))
(owed (task app s) stack-bound (by application))
(owed (task app s) stack-category (by application))
(owed (task app s) task-facts (by application))
(owed app leaves-interrupt-hardware-alone (by application))
(owed evt call-cost (by realization))
(owed evt contexts (by realization))
(owed evt masked-runs (by realization))
(owed evt no-wait (by realization))
(owed evt runtime-discipline (by realization))
(owed hw.dev.e call-cost (by realization))
(owed hw.dev.e contexts (by realization))
(owed hw.dev.e masked-runs (by realization))
(owed hw.dev.e no-wait (by realization))
(owed hw.dev.e runtime-discipline (by realization))
(owed hw.serial call-cost (by realization))
(owed hw.serial contexts (by realization))
(owed hw.serial masked-runs (by realization))
(owed hw.serial no-wait (by realization))
(owed hw.serial runtime-discipline (by realization))
(complete no)
