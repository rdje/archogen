(eadl-version eadl/1)
; A sporadic task bound itself to a source block that programs an alarm of its own on a timer: the block runs in
; the task's job, its own source's interrupt and its timer route's, the last no user of the channel, so the first
; two multiplex it (§2.6, §2.9; round 28, R4).
(defblock dev.x
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine))
  (requires (needs relative-delay)))
(defblock timer.t
  (offers (relative-delay true) (channels 1 tick) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.x timer.t)))
(defsystem own
  (task t (min-separation 20 ms) (deadline 20 ms) (deadline-from release) (priority 1) (needs interrupt-source))
  (platform (uses soc)))
