(eadl-version eadl/1)
(defblock timer.counter (offers (counter-width 32 bit) (observable-output true) (reachable-at-privilege machine)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses timer.counter)))
(defservice log.write (requires (needs observable-output) (uses time.monotonic)))
(defservice time.monotonic (requires (needs counter-width) (uses log.write)))
(defsystem cyc
  (task t (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses log.write))
  (platform (uses soc)))
