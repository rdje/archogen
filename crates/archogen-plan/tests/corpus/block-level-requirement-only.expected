== system wb
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system wb)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task wb p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses log))
(bind log observable-output console.uart)
(timer simulator (releases (task wb p)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(node console.uart block)
(node log service)
(context (task wb p) job)
(context console.uart job initialisation)
(context log job initialisation)
(depends console.uart log (because (binding observable-output)))
(step 1 console.uart)
(step 2 log)
(owed (task wb p) entry-point (by application))
(owed (task wb p) execution-bound (by application))
(owed (task wb p) execution-category (by application))
(owed (task wb p) figures-under-preemption (by application))
(owed (task wb p) masked-category (by application))
(owed (task wb p) masked-runs (by application))
(owed (task wb p) masks-only-through-api (by application))
(owed (task wb p) os-calls (by application))
(owed (task wb p) os-calls-category (by application))
(owed (task wb p) stack-bound (by application))
(owed (task wb p) stack-category (by application))
(owed (task wb p) task-facts (by application))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart masked-runs (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed log call-cost (by realization))
(owed log contexts (by realization))
(owed log masked-runs (by realization))
(owed log no-wait (by realization))
(owed log runtime-discipline (by realization))
(owed wb leaves-interrupt-hardware-alone (by application))
(complete no)
