== system ph
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ph)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ph s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source dev.e every)) (uses evtp))
(bind evtp interrupt-source dev.e)
(timer simulator (releases))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evtp) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task ph s) job)
(context dev.e job (interrupt (source dev.e)) initialisation)
(context evtp job (interrupt (source dev.e)) initialisation)
(depends dev.e evtp (because (binding interrupt-source)))
(step 1 dev.e)
(step 2 evtp)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task ph s) entry-point (by application))
(owed (task ph s) execution-bound (by application))
(owed (task ph s) execution-category (by application))
(owed (task ph s) figures-under-preemption (by application))
(owed (task ph s) masked-category (by application))
(owed (task ph s) masked-runs (by application))
(owed (task ph s) masks-only-through-api (by application))
(owed (task ph s) os-calls (by application))
(owed (task ph s) stack-bound (by application))
(owed (task ph s) stack-category (by application))
(owed (task ph s) task-facts (by application))
(owed dev.e call-cost (by realization))
(owed dev.e contexts (by realization))
(owed dev.e no-wait (by realization))
(owed evtp call-cost (by realization))
(owed evtp contexts (by realization))
(owed evtp no-wait (by realization))
(owed ph leaves-interrupt-hardware-alone (by application))
(complete no)
