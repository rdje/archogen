(eadl-version eadl/1)
; Two tasks reaching one alarm through a service that takes no channel: two tasks reach the alarm's one channel, so it
; is multiplexed (§2.9; round 7, D2).
(defblock timer.d
  (offers (relative-delay true) (channels 1 tick) (reachable-at-privilege machine)))
(defblock console.uart
  (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform soc.m
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.d console.uart)))
(defservice alarm
  (requires (needs relative-delay)))
(defservice logger
  (requires (needs observable-output) (uses alarm)))
(defsystem tu
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses logger))
  (task b (period 20 ms) (deadline 20 ms) (deadline-from release) (priority 2) (uses logger))
  (platform (uses soc.m)))
