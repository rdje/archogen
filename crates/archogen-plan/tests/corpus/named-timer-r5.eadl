(eadl-version eadl/1)
(defblock timer
  (offers (interrupt-source true) (min-arrival-separation 5 ms) (relative-delay true) (channels 1 tick)
    (reachable-at-privilege machine)))
(defplatform soc.t
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer)))
(defservice evt
  (requires (needs interrupt-source)))
(defservice alarm
  (requires (needs relative-delay)))
(defsystem named
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses evt))
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 2) (uses alarm))
  (requires (uses evt alarm))
  (platform (uses soc.t)))
