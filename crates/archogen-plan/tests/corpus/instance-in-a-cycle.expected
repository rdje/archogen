== system ic
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ic)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ic t) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses out))
(bind dma.x absolute-deadline (adapter deadline-over-delay tmr dma.x))
(bind out observable-output dma.x)
(bind tmr observable-output dma.x)
(bind (adapter deadline-over-delay tmr dma.x) counter-modulus tmr)
(bind (adapter deadline-over-delay tmr dma.x) observation-coherent tmr)
(bind (adapter deadline-over-delay tmr dma.x) relative-delay tmr)
(bind (adapter deadline-over-delay tmr dma.x) tick-rate tmr)
(instance (adapter deadline-over-delay tmr dma.x) (obliged delivery-bound) (obligations delivery chain) (costs expiry))
(timer simulator (releases (task ic t)))
(route 1 (timer-route tmr) (separation programmed) (level machine) (deliverable yes) (requesters dma.x) (costs ((adapter deadline-over-delay tmr dma.x) expiry)))
(enabled timer (timer-route tmr))
(interrupt-model (nesting no) (masking all))
(context (adapter deadline-over-delay tmr dma.x) job (interrupt (timer-route tmr)) initialisation)
(context (task ic t) job)
(context dma.x job (interrupt (timer-route tmr)) initialisation)
(context out job initialisation)
(context tmr job (interrupt (timer-route tmr)) initialisation)
(depends (adapter deadline-over-delay tmr dma.x) dma.x (because (binding absolute-deadline)))
(depends dma.x out (because (binding observable-output)))
(depends dma.x tmr (because (binding observable-output)))
(depends tmr (adapter deadline-over-delay tmr dma.x) (because (binding counter-modulus) (binding observation-coherent) (binding relative-delay) (binding tick-rate)))
(step 1 (adapter deadline-over-delay tmr dma.x) dma.x tmr)
(step 2 out)
(obligation chain (adapter deadline-over-delay tmr dma.x) (discharged-by M4.2 M4.8))
(obligation delivery (adapter deadline-over-delay tmr dma.x) (discharged-by M4.2 M4.8))
(obligation multiplex dma.x (discharged-by M4.2 M2.21.2))
(obligation route (timer-route tmr) (discharged-by M4.2 M4.3))
(owed (adapter deadline-over-delay tmr dma.x) call-cost (by realization))
(owed (adapter deadline-over-delay tmr dma.x) contexts (by realization))
(owed (adapter deadline-over-delay tmr dma.x) cost-terms (by realization))
