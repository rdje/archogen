== system bus
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system bus)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task bus p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses alarm))
(bind alarm relative-delay timer.d)
(bind evt interrupt-source dev.e)
(timer simulator (releases (task bus p)))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(route 2 (timer-route timer.d) (separation programmed) (level machine) (deliverable yes) (requesters alarm) (costs))
(enabled timer (source dev.e) (timer-route timer.d))
(interrupt-model (nesting no) (masking all))
(context (task bus p) job)
(context alarm job (interrupt (timer-route timer.d)) initialisation)
(context dev.e (interrupt (source dev.e)) initialisation)
(context evt (interrupt (source dev.e)) initialisation)
(context timer.d job (interrupt (timer-route timer.d)) initialisation)
(depends dev.e evt (because (binding interrupt-source)))
(depends timer.d alarm (because (binding relative-delay)))
(step 1 dev.e)
(step 2 evt)
(step 3 timer.d)
(step 4 alarm)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(obligation route (timer-route timer.d) (discharged-by M4.2 M4.3))
