(owed (task bus p) masks-only-through-api (by application))
(owed (task bus p) os-calls (by application))
(owed (task bus p) stack-bound (by application))
(owed (task bus p) stack-category (by application))
(owed (task bus p) task-facts (by application))
(owed (timer-route timer.d) arrival-bound (by realization))
(owed (timer-route timer.d) service-cost (by realization))
