(eadl-version eadl/1)
; Two of §1's first list at once: task `a` (rank 1) periodic and bound to a source itself, task `b` (rank 2) of period
; zero: `a` is refused, task by task in runtime order (§1; round 10, R1).
(defblock dev.e
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform soc.e
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.e)))
(defsystem two
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (needs interrupt-source))
  (task b (period 0 ms) (deadline 0 ms) (deadline-from release) (priority 2))
  (platform (uses soc.e)))
