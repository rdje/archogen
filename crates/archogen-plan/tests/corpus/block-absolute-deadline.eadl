(eadl-version eadl/1)
; A service bound to a block offering `absolute-deadline` directly: no instance, two jobs, multiplexed (§2.9; round
; 16, Q2).
(defblock rtc
  (offers (absolute-deadline true) (supported-horizon 10 s) (delivery-bound 1 us) (channels 2 tick)
    (reachable-at-privilege machine)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses rtc)))
(defservice dl (requires (absolute-deadline (delivery-bound (at-most 5 ms)))))
(defsystem bd
  (task a (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses dl))
  (task b (period 20 ms) (deadline 20 ms) (deadline-from release) (priority 2) (uses dl))
  (platform (uses soc)))
