== system both
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system both)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task both p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses alarm))
(task 1 (task both s) (rank 2) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source dev.x every)) (uses evt))
(bind alarm relative-delay dev.x)
(bind evt interrupt-source dev.x)
(timer simulator (releases (task both p)))
(route 1 (source dev.x) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(route 2 (timer-route dev.x) (separation programmed) (level machine) (deliverable yes) (requesters alarm) (costs))
(enabled timer (source dev.x) (timer-route dev.x))
(interrupt-model (nesting no) (masking all))
(context (task both p) job)
(context (task both s) job)
(context alarm job (interrupt (timer-route dev.x)) initialisation)
(context dev.x job (interrupt (source dev.x)) (interrupt (timer-route dev.x)) initialisation)
(context evt job (interrupt (source dev.x)) initialisation)
(depends dev.x alarm (because (binding relative-delay)))
(depends dev.x evt (because (binding interrupt-source)))
(step 1 dev.x)
(step 2 alarm)
(step 3 evt)
(obligation route (source dev.x) (discharged-by M4.2 M4.3))
(obligation route (timer-route dev.x) (discharged-by M4.2 M4.3))
(owed (source dev.x) acknowledge-point (by realization))
(owed (source dev.x) deferred-work (by realization))
(owed (source dev.x) service-cost (by realization))
(owed (task both p) entry-point (by application))
(owed (task both p) execution-bound (by application))
(owed (task both p) execution-category (by application))
(owed (task both p) masked-runs (by application))
(owed (task both p) os-calls (by application))
(owed (task both p) stack-bound (by application))
(owed (task both p) stack-category (by application))
(owed (task both p) task-facts (by application))
(owed (task both s) entry-point (by application))
(owed (task both s) execution-bound (by application))
(owed (task both s) execution-category (by application))
(owed (task both s) masked-runs (by application))
(owed (task both s) os-calls (by application))
(owed (task both s) stack-bound (by application))
(owed (task both s) stack-category (by application))
(owed (task both s) task-facts (by application))
(owed (timer-route dev.x) arrival-bound (by realization))
(owed (timer-route dev.x) service-cost (by realization))
(owed alarm call-cost (by realization))
(owed alarm contexts (by realization))
(owed alarm no-wait (by realization))
(owed both leaves-interrupt-hardware-alone (by application))
(owed dev.x call-cost (by realization))
(owed dev.x contexts (by realization))
(owed dev.x no-wait (by realization))
(owed evt call-cost (by realization))
(owed evt contexts (by realization))
(owed evt no-wait (by realization))
(complete no)
