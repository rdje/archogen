== system ps
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system ps)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task ps s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source soc.e every)) (uses evt))
(bind evt interrupt-source soc.e)
(timer simulator (releases))
(route 1 (source soc.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source soc.e))
(interrupt-model (nesting no) (masking all))
(context (task ps s) job)
(context evt job (interrupt (source soc.e)) initialisation)
(context soc.e job (interrupt (source soc.e)) initialisation)
(depends soc.e evt (because (binding interrupt-source)))
(step 1 soc.e)
(step 2 evt)
(obligation route (source soc.e) (discharged-by M4.2 M4.3))
(owed (source soc.e) acknowledge-point (by realization))
(owed (source soc.e) deferred-work (by realization))
(owed (source soc.e) no-application-code (by realization))
(owed (source soc.e) one-request-per-arrival (by realization))
(owed (source soc.e) service-cost (by realization))
(owed (task ps s) entry-point (by application))
(owed (task ps s) execution-bound (by application))
(owed (task ps s) execution-category (by application))
(owed (task ps s) figures-under-preemption (by application))
(owed (task ps s) masked-category (by application))
(owed (task ps s) masked-runs (by application))
(owed (task ps s) masks-only-through-api (by application))
(owed (task ps s) os-calls (by application))
(owed (task ps s) stack-bound (by application))
(owed (task ps s) stack-category (by application))
(owed (task ps s) task-facts (by application))
(owed evt call-cost (by realization))
(owed evt contexts (by realization))
(owed evt no-wait (by realization))
(owed evt runtime-discipline (by realization))
(owed ps leaves-interrupt-hardware-alone (by application))
(owed soc.e call-cost (by realization))
(owed soc.e contexts (by realization))
(owed soc.e no-wait (by realization))
(owed soc.e runtime-discipline (by realization))
(complete no)
