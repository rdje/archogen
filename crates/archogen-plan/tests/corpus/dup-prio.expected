(task 0 (task dp a) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses console.write))
(task 0 (task dp b) (rank 1) (period 1/50 s) (deadline 1/50 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses console.write))
