(eadl-version eadl/1)
; A jitter of 1e-38 ns, a time whose seconds lie past the exact arithmetic: refused `unsupported-profile`, never read
; as no time (§1, §2.2; round 10, D2).
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform host.p (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses console.uart)))
(defservice console.write (requires (needs observable-output)))
(defsystem du
  (task a (period 10 ms) (deadline 10 ms) (jitter 0.00000000000000000000000000000000000001 ns) (deadline-from release) (priority 1) (uses console.write))
  (platform (uses host.p)))
