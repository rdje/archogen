(eadl-version eadl/1)
; A block whose deadline instance programs the block itself: a component formed by bindings alone (§2.7; round 13,
; remark 4).
(defblock timer.d
  (offers (relative-delay true) (counter-modulus 65536) (tick-rate 10 MHz) (observation-coherent true)
    (channels 2 tick) (reachable-at-privilege machine))
  (requires (needs absolute-deadline)))
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform soc (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses timer.d console.uart)))
(defservice log (requires (needs observable-output)))
(defsystem bd
  (task p (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses log))
  (platform (uses soc)))
