== system su
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system su)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task su s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (unknown unreached)) (uses log))
(bind log observable-output console.uart)
(timer simulator (releases))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(node console.uart block)
(node log service)
(context (task su s) job)
(context console.uart job initialisation)
(context log job initialisation)
(depends console.uart log (because (binding observable-output)))
(step 1 console.uart)
(step 2 log)
(owed (task su s) entry-point (by application))
(owed (task su s) execution-bound (by application))
(owed (task su s) execution-category (by application))
(owed (task su s) figures-under-preemption (by application))
(owed (task su s) masked-category (by application))
(owed (task su s) masked-runs (by application))
(owed (task su s) masks-only-through-api (by application))
(owed (task su s) os-calls (by application))
(owed (task su s) os-calls-category (by application))
(owed (task su s) stack-bound (by application))
(owed (task su s) stack-category (by application))
(owed (task su s) task-facts (by application))
(owed (task su s) trigger (by description))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart masked-runs (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed log call-cost (by realization))
(owed log contexts (by realization))
(owed log masked-runs (by realization))
(owed log no-wait (by realization))
(owed log runtime-discipline (by realization))
(owed su leaves-interrupt-hardware-alone (by application))
(complete no)
