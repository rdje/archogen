== system hcb
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system hcb)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task hcb p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses))
(bind evt interrupt-source dev.e)
(timer simulator (releases (task hcb p)))
(route 1 (source dev.e) (separation 1/50 s) (level machine) (deliverable yes) (requesters evt) (costs))
(enabled timer (source dev.e))
(interrupt-model (nesting no) (masking all))
(context (task hcb p) job)
(context console.uart (interrupt (source dev.e)) initialisation)
(context dev.e (interrupt (source dev.e)) initialisation)
(context evt (interrupt (source dev.e)) initialisation)
(depends console.uart evt (because named))
(depends dev.e evt (because (binding interrupt-source)))
(step 1 console.uart)
(step 2 dev.e)
(step 3 evt)
(obligation route (source dev.e) (discharged-by M4.2 M4.3))
(owed (source dev.e) acknowledge-point (by realization))
(owed (source dev.e) deferred-work (by realization))
(owed (source dev.e) no-application-code (by realization))
(owed (source dev.e) one-request-per-arrival (by realization))
(owed (source dev.e) service-cost (by realization))
(owed (task hcb p) entry-point (by application))
(owed (task hcb p) execution-bound (by application))
(owed (task hcb p) execution-category (by application))
(owed (task hcb p) figures-under-preemption (by application))
(owed (task hcb p) masked-category (by application))
(owed (task hcb p) masked-runs (by application))
(owed (task hcb p) masks-only-through-api (by application))
(owed (task hcb p) os-calls (by application))
(owed (task hcb p) stack-bound (by application))
(owed (task hcb p) stack-category (by application))
(owed (task hcb p) task-facts (by application))
(owed console.uart contexts (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed dev.e contexts (by realization))
(owed dev.e no-wait (by realization))
(owed dev.e runtime-discipline (by realization))
(owed evt contexts (by realization))
(owed evt no-wait (by realization))
(owed evt runtime-discipline (by realization))
(owed hcb leaves-interrupt-hardware-alone (by application))
(complete no)
