== system pnb
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system pnb)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task pnb t) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses a.log))
(bind a.log debug-port dbg)
(bind console.write observable-output z.uart)
(timer simulator (releases (task pnb t)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(node a.log policy)
(node console.write service)
(node dbg block)
(node z.uart block)
(context (task pnb t) job)
(context a.log job initialisation)
(context console.write initialisation)
(context dbg job initialisation)
(context z.uart job initialisation)
(depends dbg a.log (because (binding debug-port)))
(depends z.uart a.log (because named))
(depends z.uart console.write (because (binding observable-output)))
(step 1 dbg)
(step 2 z.uart)
(step 3 a.log)
(step 4 console.write)
(owed (task pnb t) entry-point (by application))
(owed (task pnb t) execution-bound (by application))
(owed (task pnb t) execution-category (by application))
(owed (task pnb t) figures-under-preemption (by application))
(owed (task pnb t) masked-category (by application))
(owed (task pnb t) masked-runs (by application))
(owed (task pnb t) masks-only-through-api (by application))
(owed (task pnb t) os-calls (by application))
(owed (task pnb t) os-calls-category (by application))
(owed (task pnb t) stack-bound (by application))
(owed (task pnb t) stack-category (by application))
(owed (task pnb t) task-facts (by application))
(owed a.log call-cost (by realization))
(owed a.log contexts (by realization))
(owed a.log masked-runs (by realization))
(owed a.log no-wait (by realization))
(owed a.log runtime-discipline (by realization))
(owed console.write contexts (by realization))
(owed console.write no-wait (by realization))
(owed console.write runtime-discipline (by realization))
(owed dbg call-cost (by realization))
(owed dbg contexts (by realization))
(owed dbg masked-runs (by realization))
(owed dbg no-wait (by realization))
(owed dbg runtime-discipline (by realization))
(owed pnb leaves-interrupt-hardware-alone (by application))
(owed z.uart call-cost (by realization))
(owed z.uart contexts (by realization))
