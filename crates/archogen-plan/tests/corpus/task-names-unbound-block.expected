== system tnb
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system tnb)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task tnb t) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses))
(timer simulator (releases (task tnb t)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task tnb t) job)
(context console.uart job initialisation)
(step 1 console.uart)
(owed (task tnb t) entry-point (by application))
(owed (task tnb t) execution-bound (by application))
(owed (task tnb t) execution-category (by application))
(owed (task tnb t) figures-under-preemption (by application))
(owed (task tnb t) masked-category (by application))
(owed (task tnb t) masked-runs (by application))
(owed (task tnb t) masks-only-through-api (by application))
(owed (task tnb t) os-calls (by application))
(owed (task tnb t) os-calls-category (by application))
(owed (task tnb t) stack-bound (by application))
(owed (task tnb t) stack-category (by application))
(owed (task tnb t) task-facts (by application))
(owed console.uart call-cost (by realization))
(owed console.uart contexts (by realization))
(owed console.uart masked-runs (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed tnb leaves-interrupt-hardware-alone (by application))
(complete no)
