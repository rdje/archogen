== system tp
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system tp)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task tp p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses cpu))
(bind cpu core-count soc)
(bind log observable-output console.uart)
(timer simulator (releases (task tp p)))
(enabled timer)
(interrupt-model (nesting no) (masking all))
(context (task tp p) job)
(context console.uart initialisation)
(context cpu job initialisation)
(context log initialisation)
(context soc job initialisation)
(depends console.uart log (because (binding observable-output)))
(depends soc cpu (because (binding core-count)))
(step 1 console.uart)
(step 2 log)
(step 3 soc)
(step 4 cpu)
(owed (task tp p) entry-point (by application))
(owed (task tp p) execution-bound (by application))
(owed (task tp p) execution-category (by application))
(owed (task tp p) figures-under-preemption (by application))
(owed (task tp p) masked-category (by application))
(owed (task tp p) masked-runs (by application))
(owed (task tp p) masks-only-through-api (by application))
(owed (task tp p) os-calls (by application))
(owed (task tp p) stack-bound (by application))
(owed (task tp p) stack-category (by application))
(owed (task tp p) task-facts (by application))
(owed console.uart contexts (by realization))
(owed console.uart no-wait (by realization))
(owed console.uart runtime-discipline (by realization))
(owed cpu call-cost (by realization))
(owed cpu contexts (by realization))
(owed cpu masked-category (by realization))
(owed cpu masked-runs (by realization))
(owed cpu no-wait (by realization))
(owed cpu runtime-discipline (by realization))
(owed log contexts (by realization))
(owed log no-wait (by realization))
(owed log runtime-discipline (by realization))
(owed soc call-cost (by realization))
(owed soc contexts (by realization))
(owed soc masked-category (by realization))
(owed soc masked-runs (by realization))
(owed soc no-wait (by realization))
(owed soc runtime-discipline (by realization))
(owed tp leaves-interrupt-hardware-alone (by application))
(complete no)
