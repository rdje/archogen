== system sv
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system sv)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task sv s) (rank 1) (min-separation 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by (source dev.a every)) (uses ha hb))
(bind ha interrupt-source dev.b)
(bind ha min-arrival-separation dev.b)
(bind hb interrupt-source dev.a)
(bind (task sv s) interrupt-source dev.a)
(timer simulator (releases))
(route 1 (source dev.a) (separation 1/50 s) (level machine) (deliverable yes) (requesters (task sv s) hb) (costs))
(route 2 (source dev.b) (separation 3/100 s) (level machine) (deliverable yes) (requesters ha) (costs))
(enabled timer (source dev.a) (source dev.b))
(interrupt-model (nesting no) (masking all))
(node dev.a block)
(node dev.b block)
(node ha service)
(node hb service)
(context (task sv s) job)
(context dev.a job (interrupt (source dev.a)) initialisation)
(context dev.b job (interrupt (source dev.b)) initialisation)
(context ha job (interrupt (source dev.b)) initialisation)
(context hb job (interrupt (source dev.a)) initialisation)
(depends dev.a hb (because (binding interrupt-source)))
(depends dev.b ha (because (binding interrupt-source) (binding min-arrival-separation)))
(step 1 dev.a)
(step 2 dev.b)
(step 3 ha)
(step 4 hb)
(obligation route (source dev.a) (discharged-by M4.2 M4.3))
(obligation route (source dev.b) (discharged-by M4.2 M4.3))
