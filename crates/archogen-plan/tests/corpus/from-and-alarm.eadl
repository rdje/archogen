(eadl-version eadl/1)
; A deadline from another event on a task that programs an alarm itself: the first refusal §1 writes is given (round
; 9, remark 5).
(defblock timer.d
  (offers (relative-delay true) (channels 1 tick) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.d)))
(defsystem fa
  (task a (period 10 ms) (deadline 10 ms) (deadline-from activation) (priority 1) (needs relative-delay))
  (platform (uses soc)))
