(eadl-version eadl/1)
; A sporadic task reaching no source, only an output: `(unknown unreached)`, `missing-fact` (§2.2, `RTP-H1`;
; round 26, D1).
(defblock dev.a
  (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defblock console.uart
  (offers (observable-output true) (reachable-at-privilege machine)))
(defplatform soc
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses dev.a console.uart)))
(defservice log
  (requires (needs observable-output)))
(defsystem su
  (task s (min-separation 10 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses log))
  (platform (uses soc)))
