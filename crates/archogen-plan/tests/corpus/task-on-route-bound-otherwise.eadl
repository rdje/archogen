(eadl-version eadl/1)
; A task the timer route at timer.short names (through the extender it binds its counter facts to) and that is bound to
; timer.short itself, for a fact that is not consumed (observable-output): does §1's "a timer route that names it, bound
; to its provider itself" refuse it?
(defblock timer.short
  (offers
    (relative-delay true)
    (counter-modulus 65536)
    (tick-rate 10 MHz)
    (wrap-behavior modular)
    (observation-coherent true)
    (observable-output true)
    (channels 1 tick)
    (reachable-at-privilege machine)))
(defplatform soc.short
  (offers (core-count 1 tick) (reachable-at-privilege machine))
  (requires (uses timer.short)))
(defsystem tx
  (task s (period 10 ms) (deadline 10 ms) (deadline-from release) (priority 1)
    (needs counter-width tick-rate observation-coherent observable-output))
  (platform (uses soc.short)))
