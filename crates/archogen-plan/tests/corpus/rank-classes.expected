== system rc
(format "archogen-runtime-plan/1")
(profile rt-static-up-v1)
(system rc)
(program "…")
(assignment "…")
(adapters adapters/1)
(task 0 (task rc p) (rank 1) (period 1/100 s) (deadline 1/100 s) (deadline-from release) (jitter 0 s) (overrun fault) (released-by timer) (uses alarm))
(bind alarm relative-delay timer.a)
(bind ea interrupt-source dev.z)
(bind eb interrupt-source dev.z)
(bind ec interrupt-source dev.z)
(bind ez interrupt-source dev.z)
(timer simulator (releases (task rc p)))
(route 1 (source dev.z) (separation 1/20 s) (level machine) (deliverable yes) (requesters ea eb ec ez) (costs))
(route 2 (timer-route timer.a) (separation programmed) (level machine) (deliverable yes) (requesters alarm) (costs))
(enabled timer (source dev.z) (timer-route timer.a))
(interrupt-model (nesting no) (masking all))
(context (task rc p) job)
(context alarm job (interrupt (timer-route timer.a)) initialisation)
(context dev.z (interrupt (source dev.z)) initialisation)
(context ea (interrupt (source dev.z)) initialisation)
(context eb (interrupt (source dev.z)) initialisation)
(context ec (interrupt (source dev.z)) initialisation)
(context ez (interrupt (source dev.z)) initialisation)
(context timer.a job (interrupt (timer-route timer.a)) initialisation)
(depends dev.z ea (because (binding interrupt-source)))
(depends dev.z eb (because (binding interrupt-source)))
(depends dev.z ec (because (binding interrupt-source)))
(depends dev.z ez (because (binding interrupt-source)))
(depends timer.a alarm (because (binding relative-delay)))
(step 1 dev.z)
(step 2 ea)
(step 3 eb)
(step 4 ec)
(step 5 ez)
(step 6 timer.a)
(step 7 alarm)
(obligation route (source dev.z) (discharged-by M4.2 M4.3))
(obligation route (timer-route timer.a) (discharged-by M4.2 M4.3))
(owed (source dev.z) acknowledge-point (by realization))
(owed (source dev.z) deferred-work (by realization))
(owed (source dev.z) no-application-code (by realization))
(owed (source dev.z) one-request-per-arrival (by realization))
(owed (source dev.z) service-cost (by realization))
(owed (task rc p) entry-point (by application))
(owed (task rc p) execution-bound (by application))
(owed (task rc p) execution-category (by application))
(owed (task rc p) figures-under-preemption (by application))
(owed (task rc p) masked-category (by application))
(owed (task rc p) masked-runs (by application))
(owed (task rc p) masks-only-through-api (by application))
(owed (task rc p) os-calls (by application))
(owed (task rc p) stack-bound (by application))
(owed (task rc p) stack-category (by application))
(owed (task rc p) task-facts (by application))
(owed (timer-route timer.a) arrival-bound (by realization))
(owed (timer-route timer.a) service-cost (by realization))
(owed alarm call-cost (by realization))
(owed alarm contexts (by realization))
(owed alarm no-wait (by realization))
(owed dev.z contexts (by realization))
(owed dev.z no-wait (by realization))
(owed ea contexts (by realization))
(owed ea no-wait (by realization))
(owed eb contexts (by realization))
(owed eb no-wait (by realization))
(owed ec contexts (by realization))
(owed ec no-wait (by realization))
(owed ez contexts (by realization))
(owed ez no-wait (by realization))
