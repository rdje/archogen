(eadl-version eadl/1)
(defblock console.uart (offers (observable-output true) (reachable-at-privilege machine)))
(defblock timer.d (offers (relative-delay true) (counter-modulus 65536) (tick-rate 10 MHz) (observation-coherent true) (channels 2 tick) (reachable-at-privilege machine)))
(defblock dev.e (offers (interrupt-source true) (min-arrival-separation 20 ms) (reachable-at-privilege machine)))
(defplatform host.p (offers (core-count 1 tick) (reachable-at-privilege machine)) (requires (uses console.uart timer.d dev.e)))
(defservice console.write (requires (needs observable-output)))
(defservice wait.a (requires (needs relative-delay)))
(defservice wait.b (requires (needs relative-delay)))
(defservice evt (requires (needs interrupt-source) (uses console.write)))
(defsystem twice
  (task s (min-separation 30 ms) (deadline 10 ms) (deadline-from release) (priority 1) (uses evt wait.a wait.b))
  (requires (uses wait.a wait.b))
  (platform (uses host.p)))
