(format "archogen-assignment/2")
(profile rt-static-up-v1)
(system app.rt)
(program "f116a4715daf8b404d559b210f6f0d09c060158b1c1493fb133bf50197545620")
(adapters adapters/1)
(placement platform.soc.bus soc.ram)
(bind clock.time.monotonic absolute-deadline (adapter deadline-over-delay platform.timer.timer.counter clock.time.monotonic))
(bind clock.time.monotonic counter-width (adapter epoch-extender platform.timer.timer.counter))
(bind clock.time.monotonic unambiguous-horizon (adapter epoch-extender platform.timer.timer.counter))
(bind (task app.rt sensor) absolute-deadline (adapter deadline-over-delay platform.timer.timer.counter (task app.rt sensor)))
(bind (task app.rt sensor) tick-rate (adapter epoch-extender platform.timer.timer.counter))
(bind (adapter deadline-over-delay platform.timer.timer.counter (task app.rt sensor)) counter-modulus platform.timer.timer.counter)
(bind (adapter deadline-over-delay platform.timer.timer.counter (task app.rt sensor)) observation-coherent platform.timer.timer.counter)
(bind (adapter deadline-over-delay platform.timer.timer.counter (task app.rt sensor)) relative-delay platform.timer.timer.counter)
(bind (adapter deadline-over-delay platform.timer.timer.counter (task app.rt sensor)) tick-rate platform.timer.timer.counter)
(bind (adapter deadline-over-delay platform.timer.timer.counter clock.time.monotonic) counter-modulus platform.timer.timer.counter)
(bind (adapter deadline-over-delay platform.timer.timer.counter clock.time.monotonic) observation-coherent platform.timer.timer.counter)
(bind (adapter deadline-over-delay platform.timer.timer.counter clock.time.monotonic) relative-delay platform.timer.timer.counter)
(bind (adapter deadline-over-delay platform.timer.timer.counter clock.time.monotonic) tick-rate platform.timer.timer.counter)
(bind (adapter epoch-extender platform.timer.timer.counter) counter-modulus platform.timer.timer.counter)
(bind (adapter epoch-extender platform.timer.timer.counter) observation-coherent platform.timer.timer.counter)
(bind (adapter epoch-extender platform.timer.timer.counter) relative-delay platform.timer.timer.counter)
(bind (adapter epoch-extender platform.timer.timer.counter) tick-rate platform.timer.timer.counter)
(bind (adapter epoch-extender platform.timer.timer.counter) wrap-behavior platform.timer.timer.counter)
