(format "archogen-assignment/3")
(profile rt-static-up-v1)
(system app.rt)
(program "f116a4715daf8b404d559b210f6f0d09c060158b1c1493fb133bf50197545620")
(target target.riscv-virt-up "0f1e2d3c4b5a69788796a5b4c3d2e1f00f1e2d3c4b5a69788796a5b4c3d2e1f0")
(adapters adapters/1)
(placement target.riscv-virt-up target.ram)
(bind console.write observable-output target.console)
(bind (task app.rt sensor) counter-width (adapter epoch-extender target.timer))
(bind (adapter epoch-extender target.timer) counter-modulus target.timer)
(bind (release app.rt) alarm-kind target.timer)
(bind (release app.rt) relative-delay target.timer)
(bind (release app.rt) supported-horizon target.timer)
