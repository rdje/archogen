; The `riscv-virt-up` target, as eADL describes it (leaf `M2.8.3.2`).
;
; One fact for each requirement `targets/riscv-virt-up.env` names, in the corpus's own vocabulary, and nothing
; the agreement does not check (`docs/decisions/decision_target-platform-description.md`).
; `cargo xtask target-agreement` compares every fact here with the device tree the pinned QEMU presents, and
; `TARGET_VERIFIED` follows that comparison, not this file.

(eadl-version eadl/1)

; REQUIRES_PRIVILEGE: each block and the platform reachable from `machine`, the level the hart starts in at reset and
; every caller runs at under `rt-static-up-v1` — no device-tree node carries it (`M3.3.4.4`).

; REQUIRES_TIMER: the CLINT, counting at the hart's timebase.
; REQUIRES_RELEASE_TIMER: what the release requester asks of it (leaf `M4.1.7.3.3`): its delay, its one line and its
; wiring to the hart from the CLINT's `interrupts-extended`; its modulus, its compare's kind, step and magnitude, the
; states it counts in and a coherent read on RV64 from the privileged specification's machine timer; and a horizon at
; most what one compare reaches, 2^64 − 1 ticks at 10 MHz, 1 844 674 407 370.955 s, written to the second below. And what a
; system reads of the counter, from the same timer: its 64-bit width and its modular wrap (leaf `M4.1.7.3.5`).
(defblock target.timer
  (offers
    (tick-rate 10 MHz)
    (relative-delay true)
    (channels 1 tick)
    (alarm-wiring core)
    (alarm-kind level-compare)
    (counter-modulus (pow2 64))
    (counter-width 64 bit)
    (wrap-behavior modular)
    (compare-step 1 tick)
    (compare-magnitude true)
    (observation-coherent true)
    (available-in-state run idle)
    (supported-horizon 1844674407370 s)
    (reachable-at-privilege machine)
    (region target.timer (base 0x0200_0000) (size 64 KiB))))

; REQUIRES_OBSERVABLE_OUTPUT: the UART `/chosen`'s `stdout-path` names.
(defblock target.console
  (offers
    (observable-output true)
    (reachable-at-privilege machine)
    (region target.console (base 0x1000_0000) (size 256 byte))))

; REQUIRES_CORES and REQUIRES_EXECUTABLE_RAM: one hart, and the RAM `-bios none` starts the image in.
; REQUIRES_CATALOG_TARGET and REQUIRES_FIRMWARE_TRAPS: the name its catalog records go by, the `.env`'s target, and no trap
; firmware takes, `-bios none` starting the image with none beneath it.
; REQUIRES_NON_MASKABLE_INTERRUPTS: no source no mask stops: the hart offers no `smrnmi`, and QEMU 11.1.1's own source takes
; no non-maskable interrupt but Smrnmi's and connects none (leaf `M4.1.7.3.4`).
(defplatform target.riscv-virt-up
  (offers
    (core-count 1 tick)
    (catalog-target riscv-virt-up)
    (firmware-traps 0)
    (non-maskable-interrupts 0)
    (reachable-at-privilege machine)
    (region target.ram (base 0x8000_0000) (size 128 MiB) (executable true)))
  (requires (uses target.timer target.console)))
