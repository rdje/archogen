# targets/riscv-virt-up.env — the pinned emulator configuration for the `riscv-virt-up`
# environment (ROADMAP.md §3.2).
#
# ⛔ WHY PINNED. §3.2: "Pin the emulator configuration, inspect the produced hardware
# description, and verify agreement with the eADL platform fixture. Do not rely on changing
# defaults." QEMU's `virt` machine is a virtual platform whose device set and generated device
# tree depend on the release and on the options given. An unpinned invocation silently changes
# the platform under an unchanged description, which invalidates every conformance observation
# taken against it without invalidating anything the repository can see.
#
# ⚠️ VERIFICATION STATE. Every value below is a PROPOSAL until it has been checked against an
# installed QEMU. `TARGET_VERIFIED=no` says so, and `scripts/target_emulator.sh --check`
# performs the check. A proposal recorded as a proposal is a fact about our knowledge; the same
# line with `yes` and nothing behind it would be a fabricated fact, which §9 forbids
# ("Extraction output is a proposal with a source location, not automatically an accepted
# fact").
#
# Shell-sourceable KEY=VALUE. No command substitution, no interpolation.

# --- identity -------------------------------------------------------------------------------
TARGET_ID=riscv-virt-up
TARGET_KIND=emulator
TARGET_VERIFIED=no
# The leaf that flips TARGET_VERIFIED and records the evidence.
TARGET_VERIFIED_BY=M2.8

# --- the pinned emulator --------------------------------------------------------------------
# The exact QEMU release is pinned when one is first installed and verified; until then the
# field records that no release has been pinned rather than naming a plausible one.
QEMU_BINARY=qemu-system-riscv64
QEMU_VERSION_PINNED=none-yet
QEMU_MACHINE=virt
QEMU_CPU=rv64
QEMU_SMP=1
QEMU_MEMORY=128M
# -bios none: boot the generated image directly, with no firmware whose behavior we have not
# described. §3.2 wants the platform we describe, not the platform plus an opaque payload.
QEMU_BIOS=none
QEMU_DISPLAY=-nographic

# --- the agreement check (§3.2) -------------------------------------------------------------
# QEMU generates the device tree it presents to the guest. Dumping it is how the platform the
# emulator actually offers is compared against the eADL platform fixture, rather than assumed.
QEMU_DTB_DUMP_OPTION=dumpdtb
DEVICE_TREE_FIXTURE=docs/targets/riscv-virt-up.dtb.summary.md

# --- what the profile requires of any target (§3.1) -----------------------------------------
REQUIRES_CORES=1
REQUIRES_TIMER=yes
REQUIRES_OBSERVABLE_OUTPUT=yes
REQUIRES_EXECUTABLE_RAM=yes
