; trust/roots.eadl — the programs whose independence a claim relies on, the comparison harness, and the sites the
; catalog's rules refuse that a review admits (docs/specs/trust/decision_trust-inventory.md §2, §3). Read by
; `cargo xtask trust-inventory` (leaf M3.6.2) from the commit's own blob. Every form here is proposed and unaccepted
; until M3.6.5 reads acceptance; a change to this file is code-owned (M2.7.6.5).

(defroot generator
  (role generator)
  (package "crates/archogen-cli")
  (target bin archogen)
  (role-packages "crates/archogen-cli" "crates/archogen-api" "crates/archogen-emit" "crates/archogen-plan" "crates/eadl-resolve")
  (invokes configuration-checker)
  (installed "archogen-install.json"))

(defroot scheduling-checker
  (role scheduling-checker)
  (package "crates/rt-analysis")
  (target lib)
  (role-packages "crates/rt-analysis"))

(defroot reference-model
  (role reference-model)
  (package "crates/rt-reference")
  (target lib)
  (role-packages "crates/rt-reference"))

(defroot implementation
  (role implementation)
  (package "crates/rt-core")
  (target lib)
  (role-packages "crates/rt-core"))

(defharness differential
  (pair reference-model implementation)
  (package "crates/rt-core")
  (test differential))

(defroot configuration-checker
  (role configuration-checker)
  (package "crates/archogen-plan-check")
  (target bin archogen-plan-check)
  (role-packages "crates/archogen-plan-check"))

; The comparisons holding a reading of the generator's equal to the configuration checker's, each a derivation of its
; own (docs/specs/trust/decision_trust-role-programs.md §3, leaf M3.5.3.1): paired with no root, its pair taking its
; item, its class its own review's (§5). Proposed, unaccepted until M3.6.5 reads acceptance.

(defderivation production
  (pair generator configuration-checker)
  (package "crates/eadl-resolve")
  (test production)
  (reason "holds the production relation equal to the checker's executable model over the model checker's universe: each input read by both, both refusing or both reading the same state, the relation's verdict the same (decision_substitutability-relation.md §11)"))

(defderivation vocabulary
  (pair generator configuration-checker)
  (package "crates/eadl-resolve")
  (test vocabulary)
  (reason "holds the typed vocabulary table the generator reads from vocabulary.eadl equal, entry by entry, to the checker's hand-held table (decision_substitutability-relation.md §1.1)"))

(defderivation adapters
  (pair generator configuration-checker)
  (package "crates/eadl-resolve")
  (test adapters)
  (reason "holds the adapter catalog the generator reads from adapters.eadl equal, kind by kind, to the checker's hand-held table (decision_engine-adapters.md §1.2)"))

(defderivation system-reading
  (pair generator configuration-checker)
  (package "crates/eadl-resolve")
  (test system_reading)
  (reason "holds the generator's reading of a system, joint::System::read, equal to the one the configuration checker's joint check judges with, written apart under M3.5's fence: the hardware, the declarations reached and the requesters served, over every tracked system and a generated sequence of shapes (model §8 rules 1 and 7; RP-H4)"))

(defderivation target-parity
  (pair generator configuration-checker)
  (package "crates/eadl-resolve")
  (test target_parity)
  (reason "holds the generator's reading of a target and of a system on it, `eadl_resolve::target`, equal to the configuration checker's, `archogen_plan_check::target`, written apart under `docs/tasks/M3.md`'s fence: the same inputs accepted, the rest refused with the same codes, the same hardware read for a system on the target and one digest of a target, over the shipped target, the examples and each row of the correspondence record's tables; and every plan the search writes on the shipped target accepted by the checker (DC-H2; M4.1.7.5.4.2, M4.1.7.5.4.3)"))

(defderivation plan-bounded
  (pair generator configuration-checker)
  (package "crates/archogen-plan")
  (test bounded)
  (reason "the runtime plan's bounded exhaustive checker (M4.1.13): every `archogen-assignment/2` record the generator's search writes over its universes is judged by the configuration checker, `archogen_plan_check::check::plan_file`, a refusal a finding; and each record binding a task's own source model §8 rule 16 does not admit is refused by the checker and by the lowering's joint rules, the codes agreeing, each held to the test's own reading of the record (decision_runtime-plan.md §1, §2.2)"))

(defderivation plan-writers
  (pair generator configuration-checker)
  (package "crates/eadl-resolve")
  (test plan)
  (reason "holds the generator's plan writer (M3.4.3) to the format's golden and to the configuration checker's reader, program text and checks: two roles' writers of one format compared, so a divergence is found here rather than as a stale plan on every run; each writer is its own role's code. Classified as a program until leaf PROGRAM.151.3, whose reading of the record's rule, that a classification says its unit compares nothing, makes it a derivation"))

; Every other program target of the workspace, classified as not a root (§2, leaf M3.6.3.1): the reason, and the role
; packages its build compiles — its package's normal edges, an example's development edges too — so a set that grows
; is unreviewed again. Proposed, unaccepted until M3.6.5 reads acceptance. Measured 2026-10-06 by
; `cargo xtask trust-inventory`'s `program-targets`.

