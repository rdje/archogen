; trust/roots.eadl — the programs whose independence a claim relies on, the comparison harness, and the sites the
; catalog's rules refuse that a review admits (docs/decisions/decision_trust-inventory.md §2, §3). Read by
; `cargo xtask trust-inventory` (leaf M3.6.2) from the commit's own blob. Every form here is proposed and unaccepted
; until M3.6.5 reads acceptance; a change to this file is code-owned (M2.7.6.5).

(defroot generator
  (role generator)
  (package "crates/archogen-cli")
  (target bin archogen)
  (role-packages "crates/archogen-cli" "crates/archogen-api" "crates/archogen-s0"))

(defroot scheduling-checker
  (role scheduling-checker)
  (package "crates/rt-analysis")
  (target lib)
  (role-packages "crates/rt-analysis"))

(defroot reference-model
  (role reference-model)
  (package "crates/rt-reference")
  (target lib)
  (role-packages "crates/rt-reference"))

(defroot implementation
  (role implementation)
  (package "crates/rt-core")
  (target lib)
  (role-packages "crates/rt-core"))

(defharness differential
  (pair reference-model implementation)
  (package "crates/rt-core")
  (test differential))

(defrole configuration-checker
  (leaf "M3.5"))

; The sites the catalog's rules refuse in today's roots, each admitted by review once M3.6.5 reads acceptance: the
